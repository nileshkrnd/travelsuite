# Local development (4 databases on localhost)
# For Supabase / Vercel production, see .env.production.example

# KlyraAdmin — masters & configuration (Tenant, User, Company, Country, Airline, …)
ADMINCNX_URL="postgres://postgres:dev2026@127.0.0.1:5432/KlyraAdmin?schema=public"

# KlyraBase — booking / operational data
BASECNX_URL="postgres://postgres:dev2026@127.0.0.1:5432/KlyraBase?schema=public"

# KlyraAccounts — finance / accounting data
ACCOUNTSCNX_URL="postgres://postgres:dev2026@127.0.0.1:5432/KlyraAccounts?schema=public"

# KlyraHelpdesk — support tickets & mailbox sync
HELPDESKCNX_URL="postgres://postgres:dev2026@127.0.0.1:5432/KlyraHelpDesk?schema=public"

# Optional alias used by some Prisma tooling — keep pointed at Admin
DATABASE_URL="postgres://postgres:dev2026@127.0.0.1:5432/KlyraAdmin?schema=public"

# =============================================================================
# Helpdesk email → tickets
# Set HELPDESK_EMAIL_PROVIDER to: gmail  OR  microsoft365
# =============================================================================
HELPDESK_EMAIL_PROVIDER="gmail"
# Optional: pin tickets to a tenant id (defaults to first tenant in KlyraAdmin)
HELPDESK_DEFAULT_TENANT_ID=""
# Optional: hours of inbox history on each sync (default 72)
HELPDESK_SYNC_LOOKBACK_HOURS="720"
# Optional: require this secret on POST /api/helpdesk/email/sync (header x-helpdesk-sync-secret)
HELPDESK_SYNC_SECRET=""
# AES key for encrypting mailbox credentials stored in HelpdeskMailbox (Tenant Admin master)
HELPDESK_CREDENTIALS_KEY=""

# Preferred: configure mailboxes in UI — Helpdesk → Support Mailboxes (multi-inbox per tenant).
# Env below is legacy fallback only when no active mailbox rows exist for the tenant.

# --- Gmail (IMAP + App Password) — legacy fallback ---
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → generate one for Mail
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT="993"
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="465"
GMAIL_SYNC_LOOKBACK_HOURS=""
GMAIL_SYNC_MAX_MESSAGES="50"

# --- Microsoft 365 (Graph) — legacy fallback ---
# Azure App Registration → client credentials → Graph Application permission Mail.Read + admin consent
MS365_TENANT_ID=""
MS365_CLIENT_ID=""
MS365_CLIENT_SECRET=""
MS365_MAILBOX=""
MS365_SYNC_LOOKBACK_HOURS=""
