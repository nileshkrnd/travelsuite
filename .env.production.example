# =============================================================================
# Production env TEMPLATE (safe to commit) — copy to .env.production and fill in
#   cp .env.production.example .env.production
#
# TravelSuite uses Prisma → Postgres only (not Supabase JS client).
# Map Supabase "Database" connection strings into the URLs below.
# =============================================================================

# --- App / Vercel runtime (use POOLER / Prisma URL, port 6543) ----------------
# From Supabase: POSTGRES_PRISMA_URL or Session pooler connection string
ADMINCNX_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
BASECNX_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
ACCOUNTSCNX_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# --- Migrations (use DIRECT / non-pooling, port 5432) -----------------------
# From Supabase: POSTGRES_URL_NON_POOLING
# Used by: npm run db:migrate:prod
ADMINCNX_DIRECT_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
BASECNX_DIRECT_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
ACCOUNTSCNX_DIRECT_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Optional: Supabase Auth / Storage (not required by TravelSuite today) --
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# =============================================================================
# Vercel: Project → Settings → Environment Variables → Production
# Paste ADMINCNX_URL, BASECNX_URL, ACCOUNTSCNX_URL, DATABASE_URL (pooler URLs).
# Then locally once:  npm run db:migrate:prod && npm run db:seed:prod
# =============================================================================
