{
  "name": "travelsuite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "postinstall": "npm run db:generate",
    "start": "next start",
    "lint": "eslint",
    "db:create": "node scripts/create-dbs.mjs",
    "db:generate": "prisma generate --schema prisma/admin/schema.prisma && prisma generate --schema prisma/base/schema.prisma && prisma generate --schema prisma/accounts/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/admin/schema.prisma",
    "db:migrate:admin": "prisma migrate deploy --schema prisma/admin/schema.prisma",
    "db:migrate:base": "prisma migrate deploy --schema prisma/base/schema.prisma",
    "db:migrate:accounts": "prisma migrate deploy --schema prisma/accounts/schema.prisma",
    "db:migrate:all": "npm run db:migrate:admin && npm run db:migrate:base && npm run db:migrate:accounts",
    "db:migrate:prod": "node scripts/prod-db.mjs migrate",
    "db:seed:prod": "node scripts/prod-db.mjs seed",
    "db:push": "prisma db push --schema prisma/admin/schema.prisma",
    "db:studio": "prisma studio --schema prisma/admin/schema.prisma",
    "db:studio:base": "prisma studio --schema prisma/base/schema.prisma",
    "db:studio:accounts": "prisma studio --schema prisma/accounts/schema.prisma",
    "db:seed": "tsx prisma/admin/seed.ts"
  },
  "prisma": {
    "schema": "prisma/admin/schema.prisma",
    "seed": "tsx prisma/admin/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "shadcn": "^4.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
