/// Employee master — HR record linked to a login User (UserID). Scoped by TenantID + CompanyID.
model Employee {
  employeeId          Int       @id @default(autoincrement()) @map("EmployeeID")
  title               String    @map("Title") @db.VarChar(10)
  firstName           String    @map("FirstName") @db.VarChar(50)
  lastName            String    @map("LastName") @db.VarChar(50)
  gender              String    @map("Gender") @db.VarChar(10)
  countryDialCode     String    @map("CountryDialCode") @db.VarChar(5)
  phoneNumber         String    @map("PhoneNumber") @db.VarChar(20)
  faxNumber           String?   @map("FaxNumber") @db.VarChar(50)
  email               String    @map("Email") @db.VarChar(50)
  address             String    @map("Address") @db.VarChar(50)
  countryId           Int       @map("CountryID")
  cityId              Int       @map("CityID")
  employeeNumber      String    @map("EmployeeNumber") @db.VarChar(50)
  designationId       Int       @map("DesignationId")
  joiningDate         DateTime  @map("JoiningDate") @db.Timestamptz(6)
  accessRoleId        Int       @map("AccessRoleID")
  departmentId        Int?      @map("DepartmentID")
  reportingEmployeeId Int?      @map("ReportingEmployeeID")
  companyId           Int       @map("CompanyID")
  branchId            Int       @map("BranchID")
  userId              Int       @unique @map("UserID")
  employeeImage       String?   @map("EmployeeImage") @db.VarChar(100)
  tenantId            Int       @map("TenantID")
  isActive            Boolean   @default(true) @map("IsActive")
  createdBy           Int       @map("CreatedBy")
  createdDtTm         DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy          Int?      @map("ModifiedBy")
  modifiedDtTm        DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country           Country                  @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city              City                     @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  designation       Designation              @relation(fields: [designationId], references: [designationId], onDelete: Restrict)
  accessRole        AccessRole               @relation(fields: [accessRoleId], references: [accessRoleId], onDelete: Restrict)
  department        Department?              @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  reportingEmployee Employee?                @relation("EmployeeReportsTo", fields: [reportingEmployeeId], references: [employeeId], onDelete: SetNull)
  directReports     Employee[]               @relation("EmployeeReportsTo")
  company           Company                  @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  branch            Branch                   @relation(fields: [branchId], references: [branchId], onDelete: Restrict)
  user              User                     @relation(fields: [userId], references: [userId], onDelete: Restrict)
  propertyAccess    EmployeePropertyAccess[]
  signedContracts   PropertyContract[]

  @@unique([tenantId, companyId, employeeNumber], map: "Employee_Tenant_Company_Number_key")
  @@index([tenantId, companyId], map: "Employee_TenantID_CompanyID_idx")
  @@index([branchId], map: "Employee_BranchID_idx")
  @@index([departmentId], map: "Employee_DepartmentID_idx")
  @@index([designationId], map: "Employee_DesignationId_idx")
  @@index([accessRoleId], map: "Employee_AccessRoleID_idx")
  @@index([countryId], map: "Employee_CountryID_idx")
  @@index([cityId], map: "Employee_CityID_idx")
  @@map("Employee")
}

/// Grants an Employee explicit access to a Property (view/create/edit/submit/approve).
/// One row per (Employee, Property) grant, OR one row with PropertyID = NULL meaning "all properties".
/// A partial unique index (see migration) allows at most one "all properties" row per employee.
model EmployeePropertyAccess {
  employeePropertyAccessId BigInt    @id @default(autoincrement()) @map("EmployeePropertyAccessID")
  tenantId                 Int       @map("TenantID")
  companyId                Int       @map("CompanyID")
  employeeId               Int       @map("EmployeeID")
  /// NULL = access to all properties.
  propertyId               Int?      @map("PropertyID")
  canView                  Boolean   @default(true) @map("CanView")
  canCreate                Boolean   @default(false) @map("CanCreate")
  canEdit                  Boolean   @default(false) @map("CanEdit")
  canSubmit                Boolean   @default(false) @map("CanSubmit")
  canApprove               Boolean   @default(false) @map("CanApprove")
  isActive                 Boolean   @default(true) @map("IsActive")
  validFrom                DateTime? @map("ValidFrom") @db.Date
  validTo                  DateTime? @map("ValidTo") @db.Date
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)

  employee Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@unique([employeeId, propertyId], map: "EmployeePropertyAccess_Employee_Property_key")
  @@index([propertyId], map: "EmployeePropertyAccess_PropertyID_idx")
  @@index([tenantId, companyId], map: "EmployeePropertyAccess_TenantID_CompanyID_idx")
  @@map("EmployeePropertyAccess")
}

/// Global Subscription Product master — Super Admin / Tenant Configuration only.
model SubscriptionProduct {
  subscriptionProductId   Int       @id @default(autoincrement()) @map("SubscriptionProductID")
  subscriptionProductName String    @unique @map("SubscriptionProductName") @db.VarChar(50)
  description             String    @default("") @map("Description") @db.VarChar(200)
  isActive                Boolean   @default(true) @map("IsActive")
  createdBy               Int       @map("CreatedBy")
  createdDtTm             DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy              Int?      @map("ModifiedBy")
  modifiedDtTm            DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  modules   SubscriptionModule[]
  menuLinks SubscriptionModuleMenuProduct[]

  @@map("SubscriptionProduct")
}

/// Global Subscription Module master — belongs to a Subscription Product.
model SubscriptionModule {
  subscriptionModuleId   Int       @id @default(autoincrement()) @map("SubscriptionModuleID")
  subscriptionProductId  Int       @map("SubscriptionProductID")
  subscriptionModuleName String    @map("SubscriptionModuleName") @db.VarChar(50)
  description            String    @default("") @map("Description") @db.VarChar(200)
  sortOrder              Int       @default(0) @map("SortOrder")
  /// When false, module is a separate portal (e.g. B2B, CBT) — not shown in Admin/Super Admin sidebar.
  showInMenu             Boolean   @default(true) @map("ShowInMenu")
  isActive               Boolean   @default(true) @map("IsActive")
  createdBy              Int       @map("CreatedBy")
  createdDtTm            DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy             Int?      @map("ModifiedBy")
  modifiedDtTm           DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  product SubscriptionProduct        @relation(fields: [subscriptionProductId], references: [subscriptionProductId], onDelete: Restrict)
  access  SubscriptionModuleAccess[]
  menus   SubscriptionModuleMenu[]

  @@unique([subscriptionProductId, subscriptionModuleName], map: "SubscriptionModule_Product_Name_key")
  @@index([subscriptionProductId], map: "SubscriptionModule_ProductID_idx")
  @@map("SubscriptionModule")
}

/// Grants a Subscription Module to a Tenant — Super Admin / Tenant Configuration only.
model SubscriptionModuleAccess {
  subscriptionModuleAccessId Int       @id @default(autoincrement()) @map("SubscriptionModuleAccessID")
  subscriptionModuleId       Int       @map("SubscriptionModuleID")
  tenantId                   Int       @map("TenantID")
  isActive                   Boolean   @default(true) @map("IsActive")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  module SubscriptionModule @relation(fields: [subscriptionModuleId], references: [subscriptionModuleId], onDelete: Restrict)
  tenant Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([subscriptionModuleId, tenantId], map: "SubscriptionModuleAccess_Module_Tenant_key")
  @@index([subscriptionModuleId], map: "SubscriptionModuleAccess_ModuleID_idx")
  @@index([tenantId], map: "SubscriptionModuleAccess_TenantID_idx")
  @@map("SubscriptionModuleAccess")
}

/// Menus belonging to a Subscription Module — Tenant Admins only see menus for modules granted to their tenant.
/// Hierarchy, icons, and sort order are stored here (not hard-coded in the app).
model SubscriptionModuleMenu {
  subscriptionModuleMenuId Int       @id @default(autoincrement()) @map("SubscriptionModuleMenuID")
  subscriptionModuleId     Int       @map("SubscriptionModuleID")
  parentMenuId             Int?      @map("ParentMenuID")
  menuName                 String    @map("MenuName") @db.VarChar(100)
  menuUrl                  String    @map("MenuURL") @db.VarChar(200)
  menuIcon                 String    @default("Layers") @map("MenuIcon") @db.VarChar(50)
  sortOrder                Int       @default(0) @map("SortOrder")
  isActive                 Boolean   @default(true) @map("IsActive")
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy               Int?      @map("ModifiedBy")
  modifiedDtTm             DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  module              SubscriptionModule               @relation(fields: [subscriptionModuleId], references: [subscriptionModuleId], onDelete: Restrict)
  parent              SubscriptionModuleMenu?          @relation("MenuHierarchy", fields: [parentMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)
  children            SubscriptionModuleMenu[]         @relation("MenuHierarchy")
  /// Products that unlock this menu when it belongs to the shared Administration module.
  productLinks        SubscriptionModuleMenuProduct[]
  roleMenuPermissions TenantAccessRoleMenuPermission[]

  @@unique([subscriptionModuleId, menuUrl], map: "SubscriptionModuleMenu_Module_URL_key")
  @@index([subscriptionModuleId], map: "SubscriptionModuleMenu_ModuleID_idx")
  @@index([parentMenuId], map: "SubscriptionModuleMenu_ParentMenuID_idx")
  @@map("SubscriptionModuleMenu")
}

/// Per Access Role CRUD flags for each Subscription Module Menu (tenant/company scoped).
model TenantAccessRoleMenuPermission {
  tenantAccessRoleMenuPermissionId Int       @id @default(autoincrement()) @map("TenantAccessRoleMenuPermissionID")
  tenantId                         Int       @map("TenantID")
  companyId                        Int       @map("CompanyID")
  accessRoleId                     Int       @map("AccessRoleID")
  subscriptionModuleMenuId         Int       @map("SubscriptionModuleMenuID")
  canView                          Boolean   @default(false) @map("CanView")
  canCreate                        Boolean   @default(false) @map("CanCreate")
  canEdit                          Boolean   @default(false) @map("CanEdit")
  canDelete                        Boolean   @default(false) @map("CanDelete")
  canApprove                       Boolean   @default(false) @map("CanApprove")
  canExport                        Boolean   @default(false) @map("CanExport")
  canPrint                         Boolean   @default(false) @map("CanPrint")
  canReadOnly                      Boolean   @default(false) @map("CanReadOnly")
  isActive                         Boolean   @default(true) @map("IsActive")
  createdBy                        Int       @map("CreatedBy")
  createdDtTm                      DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                       Int?      @map("ModifiedBy")
  modifiedDtTm                     DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  accessRole AccessRole             @relation(fields: [accessRoleId], references: [accessRoleId], onDelete: Cascade)
  menu       SubscriptionModuleMenu @relation(fields: [subscriptionModuleMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)

  @@unique([tenantId, companyId, accessRoleId, subscriptionModuleMenuId], map: "TARMP_Tenant_Company_Role_Menu_key")
  @@index([tenantId, companyId, accessRoleId], map: "TARMP_Tenant_Company_Role_idx")
  @@index([subscriptionModuleMenuId], map: "TARMP_MenuID_idx")
  @@map("TenantAccessRoleMenuPermission")
}

/// Links an Administration menu to Subscription Products that unlock it for a tenant
/// (tenant sees the menu if they have Module Access to any module under a linked product).
/// Empty links = common admin menu (visible whenever Administration is shown).
model SubscriptionModuleMenuProduct {
  subscriptionModuleMenuProductId Int       @id @default(autoincrement()) @map("SubscriptionModuleMenuProductID")
  subscriptionModuleMenuId        Int       @map("SubscriptionModuleMenuID")
  subscriptionProductId           Int       @map("SubscriptionProductID")
  createdBy                       Int       @map("CreatedBy")
  createdDtTm                     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                      Int?      @map("ModifiedBy")
  modifiedDtTm                    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  menu    SubscriptionModuleMenu @relation(fields: [subscriptionModuleMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)
  product SubscriptionProduct    @relation(fields: [subscriptionProductId], references: [subscriptionProductId], onDelete: Restrict)

  @@unique([subscriptionModuleMenuId, subscriptionProductId], map: "SubscriptionModuleMenuProduct_Menu_Product_key")
  @@index([subscriptionModuleMenuId], map: "SubscriptionModuleMenuProduct_MenuID_idx")
  @@index([subscriptionProductId], map: "SubscriptionModuleMenuProduct_ProductID_idx")
  @@map("SubscriptionModuleMenuProduct")
}

/// Product service type catalog — Flight, Hotel, Transfer, … Tenant + Company scoped.
model ServiceTypeMaster {
  serviceTypeId   BigInt    @id @default(autoincrement()) @map("ServiceTypeID")
  tenantId        Int       @map("TenantID")
  companyId       Int       @map("CompanyID")
  serviceTypeCode String    @map("ServiceTypeCode") @db.VarChar(50)
  serviceTypeName String    @map("ServiceTypeName") @db.VarChar(100)
  description     String?   @map("Description") @db.VarChar(500)
  icon            String?   @map("Icon") @db.VarChar(200)
  displayOrder    Int       @default(0) @map("DisplayOrder")
  isActive        Boolean   @default(true) @map("IsActive")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  classifications ServiceProductClassificationMaster[]
  categories      ServiceProductCategory[]
  configurations  ServiceTypeConfiguration[]
  serviceProducts ServiceProduct[]

  @@unique([tenantId, companyId, serviceTypeCode], map: "ServiceTypeMaster_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "ServiceTypeMaster_TenantID_CompanyID_idx")
  @@map("ServiceTypeMaster")
}

/// Classification/sub-category under a Service Type — self-referencing for a hierarchy (e.g. Hotel > Resort > Beach Resort).
model ServiceProductClassificationMaster {
  serviceProductClassificationId BigInt    @id @default(autoincrement()) @map("ServiceProductClassificationID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  serviceTypeId                  BigInt    @map("ServiceTypeID")
  classificationCode             String    @map("ClassificationCode") @db.VarChar(50)
  classificationName             String    @map("ClassificationName") @db.VarChar(150)
  parentClassificationId         BigInt?   @map("ParentClassificationID")
  description                    String?   @map("Description") @db.VarChar(500)
  icon                           String?   @map("Icon") @db.VarChar(200)
  displayOrder                   Int       @default(0) @map("DisplayOrder")
  isActive                       Boolean   @default(true) @map("IsActive")
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceType     ServiceTypeMaster                           @relation(fields: [serviceTypeId], references: [serviceTypeId], onDelete: Restrict)
  parent          ServiceProductClassificationMaster?         @relation("ServiceProductClassificationHierarchy", fields: [parentClassificationId], references: [serviceProductClassificationId], onDelete: Restrict, onUpdate: Restrict)
  children        ServiceProductClassificationMaster[]        @relation("ServiceProductClassificationHierarchy")
  categories      ServiceProductCategory[]
  configurations  ServiceProductClassificationConfiguration[]
  serviceProducts ServiceProduct[]

  @@unique([tenantId, companyId, serviceTypeId, classificationCode], map: "SvcProductClassification_Tenant_Company_Type_Code_key")
  @@index([tenantId, companyId], map: "ServiceProductClassificationMaster_TenantID_CompanyID_idx")
  @@index([serviceTypeId], map: "ServiceProductClassificationMaster_ServiceTypeID_idx")
  @@index([parentClassificationId], map: "ServiceProductClassificationMaster_ParentClassificationID_idx")
  @@map("ServiceProductClassificationMaster")
}

/// Category/sub-category under a Service Type (optionally within a Classification) — self-referencing for a hierarchy (e.g. Hotel > Beach Resort > Overwater Villas).
model ServiceProductCategory {
  serviceProductCategoryId       BigInt    @id @default(autoincrement()) @map("ServiceProductCategoryID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  serviceTypeId                  BigInt    @map("ServiceTypeID")
  serviceProductClassificationId BigInt?   @map("ServiceProductClassificationID")
  parentServiceProductCategoryId BigInt?   @map("ParentServiceProductCategoryID")
  categoryCode                   String    @map("CategoryCode") @db.VarChar(50)
  categoryName                   String    @map("CategoryName") @db.VarChar(150)
  description                    String?   @map("Description") @db.VarChar(500)
  icon                           String?   @map("Icon") @db.VarChar(200)
  imageUrl                       String?   @map("ImageURL") @db.VarChar(500)
  displayOrder                   Int       @default(0) @map("DisplayOrder")
  isFeatured                     Boolean   @default(false) @map("IsFeatured")
  isActive                       Boolean   @default(true) @map("IsActive")
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceType     ServiceTypeMaster                   @relation(fields: [serviceTypeId], references: [serviceTypeId], onDelete: Restrict)
  classification  ServiceProductClassificationMaster? @relation(fields: [serviceProductClassificationId], references: [serviceProductClassificationId], onDelete: Restrict)
  parent          ServiceProductCategory?             @relation("ServiceProductCategoryHierarchy", fields: [parentServiceProductCategoryId], references: [serviceProductCategoryId], onDelete: Restrict, onUpdate: Restrict)
  children        ServiceProductCategory[]            @relation("ServiceProductCategoryHierarchy")
  serviceProducts ServiceProduct[]

  @@unique([tenantId, companyId, serviceTypeId, categoryCode], map: "SvcProductCategory_Tenant_Company_Type_Code_key")
  @@index([tenantId, companyId], map: "ServiceProductCategory_TenantID_CompanyID_idx")
  @@index([serviceTypeId], map: "ServiceProductCategory_ServiceTypeID_idx")
  @@index([serviceProductClassificationId], map: "ServiceProductCategory_ClassificationID_idx")
  @@index([parentServiceProductCategoryId], map: "ServiceProductCategory_ParentCategoryID_idx")
  @@map("ServiceProductCategory")
}

/// Duration unit catalog — Minute, Hour, Day, Night, Week, Month.
model DurationUnit {
