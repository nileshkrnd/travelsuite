  @@index([propertyId], map: "PropertyRoom_PropertyID_idx")
  @@index([roomTypeId], map: "PropertyRoom_RoomTypeID_idx")
  @@index([roomSizeUnitId], map: "PropertyRoom_RoomSizeUnitID_idx")
  @@index([smokingTypeId], map: "PropertyRoom_SmokingTypeID_idx")
  @@index([viewTypeId], map: "PropertyRoom_ViewTypeID_idx")
  @@map("PropertyRoom")
}

