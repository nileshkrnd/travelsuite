  @@index([propertyContractId], map: "PropertyContractStopSale_PropertyContractID_idx")
  @@index([stopSaleTypeId], map: "PropertyContractStopSale_StopSaleTypeID_idx")
  @@index([propertyRoomId], map: "PropertyContractStopSale_PropertyRoomTypeID_idx")
  @@index([propertyContractRatePlanId], map: "PropertyContractStopSale_RatePlanID_idx")
  @@index([stopSaleReasonId], map: "PropertyContractStopSale_StopSaleReasonID_idx")
  @@map("PropertyContractStopSale")
}

