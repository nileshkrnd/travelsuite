  @@unique([propertyContractRateId, dayOfWeekId], map: "PropertyContractRateDay_Rate_Day_key")
  @@index([propertyContractRateId], map: "PropertyContractRateDay_PropertyContractRateID_idx")
  @@index([dayOfWeekId], map: "PropertyContractRateDay_DayOfWeekID_idx")
  @@map("PropertyContractRateDay")
}

/// Daily room inventory for a property room type (ARI — availability).
model PropertyRoomAvailability {
  propertyRoomAvailabilityId BigInt    @id @default(autoincrement()) @map("PropertyRoomAvailabilityID")
  tenantId                   Int       @map("TenantID")
  companyId                  Int       @map("CompanyID")
  propertyId                 Int       @map("PropertyID")
  /// Property room type (PropertyRoom master — domain PropertyRoomTypeID).
  propertyRoomId             BigInt    @map("PropertyRoomTypeID")
  availabilityDate           DateTime  @map("AvailabilityDate") @db.Date
  availableUnits             Int       @default(0) @map("AvailableUnits")
  stopSell                   Boolean   @default(false) @map("StopSell")
  /// Closed to arrival (CTA) — no check-in on this date.
  closedToArrival            Boolean   @default(false) @map("ClosedToArrival")
  /// Closed to departure (CTD) — no check-out on this date.
  closedToDeparture          Boolean   @default(false) @map("ClosedToDeparture")
  /// Optional daily rate override (falls back to contract rate when null).
  dailyRateAmount            Decimal?  @map("DailyRateAmount") @db.Decimal(18, 4)
  /// Optional daily inventory override (falls back to contract allotment when null).
  dailyInventoryQty          Int?      @map("DailyInventoryQty")
  minLengthOfStay            Int?      @map("MinLengthOfStay")
  maxLengthOfStay            Int?      @map("MaxLengthOfStay")
  isActive                   Boolean   @default(true) @map("IsActive")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  property     Property     @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  propertyRoom PropertyRoom @relation(fields: [propertyRoomId], references: [propertyRoomId], onDelete: Cascade)
  occupancyRateOverrides PropertyRoomAvailabilityRate[]

  @@unique([tenantId, propertyRoomId, availabilityDate], map: "PropertyRoomAvailability_Room_Date_key")
  @@index([tenantId, companyId], map: "PropertyRoomAvailability_TenantID_CompanyID_idx")
  @@index([propertyId, availabilityDate], map: "PropertyRoomAvailability_Property_Date_idx")
  @@index([propertyRoomId], map: "PropertyRoomAvailability_PropertyRoomTypeID_idx")
  @@map("PropertyRoomAvailability")
}

/// Daily override of a contract rate for a specific rate plan + occupancy type (falls back to the contract rate when absent).
model PropertyRoomAvailabilityRate {
  propertyRoomAvailabilityRateId BigInt    @id @default(autoincrement()) @map("PropertyRoomAvailabilityRateID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  propertyRoomAvailabilityId     BigInt    @map("PropertyRoomAvailabilityID")
  propertyContractRatePlanId     BigInt    @map("PropertyContractRatePlanID")
