  roomSizeUnit RoomSizeUnit? @relation(fields: [roomSizeUnitId], references: [roomSizeUnitId], onDelete: SetNull)
  smokingType  SmokingType?  @relation(fields: [smokingTypeId], references: [smokingTypeId], onDelete: SetNull)
