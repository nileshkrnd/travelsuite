  propertyContractStopSaleId BigInt    @id @default(autoincrement()) @map("PropertyContractStopSaleID")
  tenantId                   Int       @map("TenantID")
  companyId                  Int       @map("CompanyID")
  propertyContractId         BigInt    @map("PropertyContractID")
  stopSaleTypeId             BigInt    @map("StopSaleTypeID")
