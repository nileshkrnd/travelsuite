  createdDtTm   DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy    Int?      @map("ModifiedBy")
  modifiedDtTm  DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contractRateDays PropertyContractRateDay[]
  contractSupplementDays PropertyContractSupplementDay[]
  contractPromotionDays  PropertyContractPromotionDay[]
  contractStopSaleDays   PropertyContractStopSaleDay[]
  contractBlackoutDays   PropertyContractBlackoutDay[]

  @@map("DayOfWeek")
}

/// Applicable days for a contracted rate (Mon–Sun flags per PropertyContractRate).
model PropertyContractRateDay {
  propertyContractRateDayId BigInt    @id @default(autoincrement()) @map("PropertyContractRateDayID")
  propertyContractRateId    BigInt    @map("PropertyContractRateID")
