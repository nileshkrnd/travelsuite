  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  promotion PropertyContractPromotion @relation(fields: [propertyContractPromotionId], references: [propertyContractPromotionId], onDelete: Cascade)
  dayOfWeek DayOfWeek                 @relation(fields: [dayOfWeekId], references: [dayOfWeekId], onDelete: Restrict)

  @@unique([propertyContractPromotionId, dayOfWeekId], map: "PropertyContractPromotionDay_Promotion_Day_key")
