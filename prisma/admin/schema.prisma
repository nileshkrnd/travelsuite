  @@index([serviceProductVariantId], map: "SvcProductRate_VariantID_idx")
  @@index([serviceProductScheduleId], map: "SvcProductRate_ScheduleID_idx")
  @@index([rateTypeId], map: "SvcProductRate_RateTypeID_idx")
  @@index([commonStatusId], map: "SvcProductRate_CommonStatusID_idx")
  @@map("ServiceProductRate")
