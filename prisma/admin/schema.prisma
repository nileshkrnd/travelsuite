  ratePlanTypeId             BigInt    @map("RatePlanTypeID")
  mealPlanId                 BigInt    @map("MealPlanID")
  rateBasisId                BigInt    @map("RateBasisID")
  isActive                   Boolean   @default(true) @map("IsActive")
  displayOrder               Int       @default(0) @map("DisplayOrder")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  propertyContract          PropertyContract                     @relation(fields: [propertyContractId], references: [propertyContractId], onDelete: Cascade)
  ratePlanType              RatePlanType                         @relation(fields: [ratePlanTypeId], references: [ratePlanTypeId], onDelete: Restrict)
  mealPlan                  MealPlan                             @relation(fields: [mealPlanId], references: [mealPlanId], onDelete: Restrict)
  rateBasis                 RateBasis                            @relation(fields: [rateBasisId], references: [rateBasisId], onDelete: Restrict)
  contractRates             PropertyContractRate[]
  supplementRatePlans       PropertyContractSupplementRatePlan[]
  cancellationPolicies      PropertyContractCancellationPolicy[]
  contractPromotions        PropertyContractPromotion[]
  contractStopSales         PropertyContractStopSale[]
  contractBlackouts         PropertyContractBlackout[]
  availabilityRateOverrides PropertyRoomAvailabilityRate[]

  @@unique([tenantId, propertyContractId, ratePlanCode], map: "PropertyContractRatePlan_Tenant_Contract_Code_key")
  @@index([tenantId, companyId], map: "PropertyContractRatePlan_TenantID_CompanyID_idx")
  @@index([propertyContractId], map: "PropertyContractRatePlan_PropertyContractID_idx")
  @@index([ratePlanTypeId], map: "PropertyContractRatePlan_RatePlanTypeID_idx")
  @@index([mealPlanId], map: "PropertyContractRatePlan_MealPlanID_idx")
  @@index([rateBasisId], map: "PropertyContractRatePlan_RateBasisID_idx")
  @@map("PropertyContractRatePlan")
}

/// Contracted rate for a season period + rate plan + room type + occupancy.
model PropertyContractRate {
  propertyContractRateId         BigInt    @id @default(autoincrement()) @map("PropertyContractRateID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  propertyContractId             BigInt    @map("PropertyContractID")
  propertyContractSeasonPeriodId BigInt    @map("PropertyContractSeasonPeriodID")
  propertyContractRatePlanId     BigInt    @map("PropertyContractRatePlanID")
  /// Property room type (PropertyRoom master — domain PropertyRoomTypeID).
  propertyRoomId                 BigInt    @map("PropertyRoomTypeID")
  occupancyTypeId                BigInt    @map("OccupancyTypeID")
  rateAmount                     Decimal   @map("RateAmount") @db.Decimal(18, 4)
  isActive                       Boolean   @default(true) @map("IsActive")
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  propertyContract PropertyContract             @relation(fields: [propertyContractId], references: [propertyContractId], onDelete: Cascade)
  seasonPeriod     PropertyContractSeasonPeriod @relation(fields: [propertyContractSeasonPeriodId], references: [propertyContractSeasonPeriodId], onDelete: Restrict)
  ratePlan         PropertyContractRatePlan     @relation(fields: [propertyContractRatePlanId], references: [propertyContractRatePlanId], onDelete: Restrict)
  propertyRoom     PropertyRoom                 @relation(fields: [propertyRoomId], references: [propertyRoomId], onDelete: Restrict)
  occupancyType    OccupancyType                @relation(fields: [occupancyTypeId], references: [occupancyTypeId], onDelete: Restrict)
  rateDays         PropertyContractRateDay[]

  @@unique([tenantId, propertyContractId, propertyContractSeasonPeriodId, propertyContractRatePlanId, propertyRoomId, occupancyTypeId], map: "PropertyContractRate_Unique_key")
  @@index([tenantId, companyId], map: "PropertyContractRate_TenantID_CompanyID_idx")
  @@index([propertyContractId], map: "PropertyContractRate_PropertyContractID_idx")
  @@index([propertyContractSeasonPeriodId], map: "PropertyContractRate_SeasonPeriodID_idx")
  @@index([propertyContractRatePlanId], map: "PropertyContractRate_RatePlanID_idx")
  @@index([propertyRoomId], map: "PropertyContractRate_PropertyRoomTypeID_idx")
  @@index([occupancyTypeId], map: "PropertyContractRate_OccupancyTypeID_idx")
  @@map("PropertyContractRate")
}

/// Occupancy Type master — Single, Double, Triple, … Tenant + Company scoped.
model OccupancyType {
  occupancyTypeId   BigInt    @id @default(autoincrement()) @map("OccupancyTypeID")
  tenantId          Int       @map("TenantID")
  companyId         Int       @map("CompanyID")
  occupancyTypeCode String    @map("OccupancyTypeCode") @db.VarChar(50)
  occupancyTypeName String    @map("OccupancyTypeName") @db.VarChar(100)
  description       String?   @map("Description") @db.VarChar(500)
  displayOrder      Int       @default(0) @map("DisplayOrder")
  isActive          Boolean   @default(true) @map("IsActive")
  createdBy         Int       @map("CreatedBy")
  createdDtTm       DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy        Int?      @map("ModifiedBy")
  modifiedDtTm      DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contractRates             PropertyContractRate[]
  availabilityRateOverrides PropertyRoomAvailabilityRate[]

  @@unique([tenantId, companyId, occupancyTypeCode], map: "OccupancyType_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "OccupancyType_TenantID_CompanyID_idx")
  @@map("OccupancyType")
}

/// Day of week master — Monday–Sunday. Global reference data.
model DayOfWeek {
  dayOfWeekId   BigInt    @id @default(autoincrement()) @map("DayOfWeekID")
  dayOfWeekCode String    @unique @map("DayOfWeekCode") @db.VarChar(10)
  dayOfWeekName String    @map("DayOfWeekName") @db.VarChar(20)
  shortName     String    @map("ShortName") @db.VarChar(3)
  displayOrder  Int       @default(0) @map("DisplayOrder")
  isActive      Boolean   @default(true) @map("IsActive")
  createdBy     Int       @map("CreatedBy")
  createdDtTm   DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy    Int?      @map("ModifiedBy")
  modifiedDtTm  DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contractRateDays               PropertyContractRateDay[]
  contractSupplementDays         PropertyContractSupplementDay[]
  contractPromotionDays          PropertyContractPromotionDay[]
  contractStopSaleDays           PropertyContractStopSaleDay[]
  contractBlackoutDays           PropertyContractBlackoutDay[]
  serviceProductAvailabilityDays ServiceProductAvailabilityDay[]
  serviceProductSchedules        ServiceProductSchedule[]
  serviceProductRateDays         ServiceProductRateDay[]

  @@map("DayOfWeek")
}

/// Applicable days for a contracted rate (Mon–Sun flags per PropertyContractRate).
model PropertyContractRateDay {
  propertyContractRateDayId BigInt    @id @default(autoincrement()) @map("PropertyContractRateDayID")
  propertyContractRateId    BigInt    @map("PropertyContractRateID")
  dayOfWeekId               BigInt    @map("DayOfWeekID")
  isActive                  Boolean   @default(true) @map("IsActive")
  createdBy                 Int       @map("CreatedBy")
  createdDtTm               DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                Int?      @map("ModifiedBy")
  modifiedDtTm              DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contractRate PropertyContractRate @relation(fields: [propertyContractRateId], references: [propertyContractRateId], onDelete: Cascade)
  dayOfWeek    DayOfWeek            @relation(fields: [dayOfWeekId], references: [dayOfWeekId], onDelete: Restrict)

  @@unique([propertyContractRateId, dayOfWeekId], map: "PropertyContractRateDay_Rate_Day_key")
  @@index([propertyContractRateId], map: "PropertyContractRateDay_PropertyContractRateID_idx")
  @@index([dayOfWeekId], map: "PropertyContractRateDay_DayOfWeekID_idx")
  @@map("PropertyContractRateDay")
}

/// Daily room inventory for a property room type (ARI — availability).
model PropertyRoomAvailability {
  propertyRoomAvailabilityId BigInt    @id @default(autoincrement()) @map("PropertyRoomAvailabilityID")
  tenantId                   Int       @map("TenantID")
  companyId                  Int       @map("CompanyID")
  propertyId                 Int       @map("PropertyID")
  /// Property room type (PropertyRoom master — domain PropertyRoomTypeID).
  propertyRoomId             BigInt    @map("PropertyRoomTypeID")
  availabilityDate           DateTime  @map("AvailabilityDate") @db.Date
  availableUnits             Int       @default(0) @map("AvailableUnits")
  stopSell                   Boolean   @default(false) @map("StopSell")
  /// Closed to arrival (CTA) — no check-in on this date.
  closedToArrival            Boolean   @default(false) @map("ClosedToArrival")
  /// Closed to departure (CTD) — no check-out on this date.
  closedToDeparture          Boolean   @default(false) @map("ClosedToDeparture")
  /// Optional daily rate override (falls back to contract rate when null).
  dailyRateAmount            Decimal?  @map("DailyRateAmount") @db.Decimal(18, 4)
  /// Optional daily inventory override (falls back to contract allotment when null).
  dailyInventoryQty          Int?      @map("DailyInventoryQty")
  minLengthOfStay            Int?      @map("MinLengthOfStay")
  maxLengthOfStay            Int?      @map("MaxLengthOfStay")
  isActive                   Boolean   @default(true) @map("IsActive")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  property               Property                       @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  propertyRoom           PropertyRoom                   @relation(fields: [propertyRoomId], references: [propertyRoomId], onDelete: Cascade)
  occupancyRateOverrides PropertyRoomAvailabilityRate[]

  @@unique([tenantId, propertyRoomId, availabilityDate], map: "PropertyRoomAvailability_Room_Date_key")
  @@index([tenantId, companyId], map: "PropertyRoomAvailability_TenantID_CompanyID_idx")
  @@index([propertyId, availabilityDate], map: "PropertyRoomAvailability_Property_Date_idx")
  @@index([propertyRoomId], map: "PropertyRoomAvailability_PropertyRoomTypeID_idx")
  @@map("PropertyRoomAvailability")
}

/// Daily override of a contract rate for a specific rate plan + occupancy type (falls back to the contract rate when absent).
model PropertyRoomAvailabilityRate {
  propertyRoomAvailabilityRateId BigInt    @id @default(autoincrement()) @map("PropertyRoomAvailabilityRateID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  propertyRoomAvailabilityId     BigInt    @map("PropertyRoomAvailabilityID")
  propertyContractRatePlanId     BigInt    @map("PropertyContractRatePlanID")
  occupancyTypeId                BigInt    @map("OccupancyTypeID")
  rateAmount                     Decimal   @map("RateAmount") @db.Decimal(18, 4)
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  propertyRoomAvailability PropertyRoomAvailability @relation(fields: [propertyRoomAvailabilityId], references: [propertyRoomAvailabilityId], onDelete: Cascade)
  ratePlan                 PropertyContractRatePlan @relation(fields: [propertyContractRatePlanId], references: [propertyContractRatePlanId], onDelete: Cascade)
  occupancyType            OccupancyType            @relation(fields: [occupancyTypeId], references: [occupancyTypeId], onDelete: Cascade)

  @@unique([tenantId, propertyRoomAvailabilityId, propertyContractRatePlanId, occupancyTypeId], map: "PropertyRoomAvailabilityRate_Unique_key")
  @@index([propertyRoomAvailabilityId], map: "PropertyRoomAvailabilityRate_AvailabilityID_idx")
  @@index([propertyContractRatePlanId], map: "PropertyRoomAvailabilityRate_RatePlanID_idx")
  @@index([occupancyTypeId], map: "PropertyRoomAvailabilityRate_OccupancyTypeID_idx")
  @@map("PropertyRoomAvailabilityRate")
}

/// Inventory type lookup — Allotment / Free Sale / On Request. Global reference data.
model InventoryType {
  inventoryTypeId   BigInt    @id @default(autoincrement()) @map("InventoryTypeID")
  inventoryTypeCode String    @unique @map("InventoryTypeCode") @db.VarChar(50)
  inventoryTypeName String    @map("InventoryTypeName") @db.VarChar(100)
  description       String?   @map("Description") @db.VarChar(500)
  displayOrder      Int       @default(0) @map("DisplayOrder")
