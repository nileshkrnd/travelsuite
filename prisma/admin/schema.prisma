/// The core sellable product catalog entry — Transfer/Tour/Activity/etc. product, classified and optionally categorized, with a primary supplier/location and a lifecycle status.
model ServiceProduct {
  serviceProductId               BigInt    @id @default(autoincrement()) @map("ServiceProductID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  serviceProductCode             String    @map("ServiceProductCode") @db.VarChar(50)
  serviceProductName             String    @map("ServiceProductName") @db.VarChar(250)
  serviceTypeId                  BigInt    @map("ServiceTypeID")
  serviceProductClassificationId BigInt    @map("ServiceProductClassificationID")
  serviceProductCategoryId       BigInt?   @map("ServiceProductCategoryID")
  supplierId                     BigInt?   @map("SupplierID")
  countryId                      Int?      @map("CountryID")
  regionId                       Int?      @map("RegionID")
  cityId                         Int?      @map("CityID")
  shortDescription               String?   @map("ShortDescription") @db.VarChar(1000)
  description                    String?   @map("Description") @db.Text
  isOnlineSellable               Boolean   @default(false) @map("IsOnlineSellable")
  isFeatured                     Boolean   @default(false) @map("IsFeatured")
  displayOrder                   Int       @default(0) @map("DisplayOrder")
  commonStatusId                 BigInt    @map("CommonStatusID")
  isActive                       Boolean   @default(true) @map("IsActive")
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceType    ServiceTypeMaster                  @relation(fields: [serviceTypeId], references: [serviceTypeId], onDelete: Restrict)
  classification ServiceProductClassificationMaster @relation(fields: [serviceProductClassificationId], references: [serviceProductClassificationId], onDelete: Restrict)
  category       ServiceProductCategory?            @relation(fields: [serviceProductCategoryId], references: [serviceProductCategoryId], onDelete: Restrict)
  supplier       Supplier?                          @relation(fields: [supplierId], references: [supplierId], onDelete: SetNull)
  country        Country?                           @relation(fields: [countryId], references: [countryId], onDelete: SetNull)
  region         Region?                            @relation(fields: [regionId], references: [regionId], onDelete: SetNull)
  city           City?                              @relation(fields: [cityId], references: [cityId], onDelete: SetNull)
  commonStatus   CommonStatus                       @relation(fields: [commonStatusId], references: [commonStatusId], onDelete: Restrict)

  configuration       ServiceProductConfiguration?
  statusHistory       ServiceProductStatusHistory[]
  options             ServiceProductOption[]
  supplierLinks       ServiceProductSupplier[]
  availabilities      ServiceProductAvailability[]
  schedules           ServiceProductSchedule[]
  rates               ServiceProductRate[]
  locations           ServiceProductLocation[]
  media               ServiceProductMedia[]
  inclusionExclusions ServiceProductInclusionExclusion[]

  @@unique([tenantId, companyId, serviceProductCode], map: "ServiceProduct_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "ServiceProduct_TenantID_CompanyID_idx")
