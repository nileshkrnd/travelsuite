  @@index([serviceProductClassificationId], map: "ServiceProduct_ClassificationID_idx")
  @@index([serviceProductCategoryId], map: "ServiceProduct_CategoryID_idx")
  @@index([supplierId], map: "ServiceProduct_SupplierID_idx")
  @@index([commonStatusId], map: "ServiceProduct_CommonStatusID_idx")
  @@map("ServiceProduct")
}

/// One configuration row per Service Product — duration/booking/pricing model and the boolean "does this product require X" flags.
