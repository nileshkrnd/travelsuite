  serviceProductRateId    BigInt    @map("ServiceProductRateID")
  dayOfWeekId             BigInt    @map("DayOfWeekID")
  isActive                Boolean   @default(true) @map("IsActive")
  createdBy               Int       @map("CreatedBy")
  createdDtTm             DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy              Int?      @map("ModifiedBy")
  modifiedDtTm            DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  rate      ServiceProductRate @relation(fields: [serviceProductRateId], references: [serviceProductRateId], onDelete: Cascade)
  dayOfWeek DayOfWeek          @relation(fields: [dayOfWeekId], references: [dayOfWeekId], onDelete: Restrict)

  @@unique([serviceProductRateId, dayOfWeekId], map: "SvcProductRateDay_Rate_Day_key")
  @@index([dayOfWeekId], map: "SvcProductRateDay_DayOfWeekID_idx")
  @@map("ServiceProductRateDay")
}

/// Location type lookup for Service Products — Destination, Pickup, Drop-off, Meeting Point, Airport, … Global.
model ServiceProductLocationType {
  serviceProductLocationTypeId BigInt    @id @default(autoincrement()) @map("ServiceProductLocationTypeID")
  locationTypeCode             String    @unique @map("LocationTypeCode") @db.VarChar(50)
  locationTypeName             String    @map("LocationTypeName") @db.VarChar(100)
  description                  String?   @map("Description") @db.VarChar(500)
  isPickupLocation             Boolean   @default(false) @map("IsPickupLocation")
  isDropoffLocation            Boolean   @default(false) @map("IsDropoffLocation")
  isMeetingPoint               Boolean   @default(false) @map("IsMeetingPoint")
  isDestination                Boolean   @default(false) @map("IsDestination")
  displayOrder                 Int       @default(0) @map("DisplayOrder")
  isActive                     Boolean   @default(true) @map("IsActive")
  createdBy                    Int       @map("CreatedBy")
  createdDtTm                  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                   Int?      @map("ModifiedBy")
  modifiedDtTm                 DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  locations         ServiceProductLocation[]
  supplierLocations ServiceProductSupplierLocation[]

  @@map("ServiceProductLocationType")
}

/// A physical location tied to a Service Product — pickup point, meeting point, destination, venue, … Country required; Region/City/Area optional.
model ServiceProductLocation {
  serviceProductLocationId     BigInt    @id @default(autoincrement()) @map("ServiceProductLocationID")
  serviceProductId             BigInt    @map("ServiceProductID")
  serviceProductLocationTypeId BigInt    @map("ServiceProductLocationTypeID")
  countryId                    Int       @map("CountryID")
  regionId                     Int?      @map("RegionID")
  cityId                       Int?      @map("CityID")
  areaId                       Int?      @map("AreaID")
  locationName                 String    @map("LocationName") @db.VarChar(250)
  addressLine1                 String?   @map("AddressLine1") @db.VarChar(500)
  addressLine2                 String?   @map("AddressLine2") @db.VarChar(500)
  postalCode                   String?   @map("PostalCode") @db.VarChar(30)
  latitude                     Decimal?  @map("Latitude") @db.Decimal(10, 7)
  longitude                    Decimal?  @map("Longitude") @db.Decimal(10, 7)
  googlePlaceId                String?   @map("GooglePlaceID") @db.VarChar(200)
  googleMapUrl                 String?   @map("GoogleMapURL") @db.VarChar(1000)
  locationInstructions         String?   @map("LocationInstructions") @db.VarChar(2000)
  isPrimary                    Boolean   @default(false) @map("IsPrimary")
  displayOrder                 Int       @default(0) @map("DisplayOrder")
  commonStatusId               BigInt    @map("CommonStatusID")
  isActive                     Boolean   @default(true) @map("IsActive")
  createdBy                    Int       @map("CreatedBy")
  createdDtTm                  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                   Int?      @map("ModifiedBy")
  modifiedDtTm                 DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceProduct ServiceProduct             @relation(fields: [serviceProductId], references: [serviceProductId], onDelete: Cascade)
  locationType   ServiceProductLocationType @relation(fields: [serviceProductLocationTypeId], references: [serviceProductLocationTypeId], onDelete: Restrict)
  country        Country                    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  region         Region?                    @relation(fields: [regionId], references: [regionId], onDelete: SetNull)
  city           City?                      @relation(fields: [cityId], references: [cityId], onDelete: SetNull)
  area           Area?                      @relation(fields: [areaId], references: [areaId], onDelete: SetNull)
  commonStatus   CommonStatus               @relation(fields: [commonStatusId], references: [commonStatusId], onDelete: Restrict)

  supplierLocations ServiceProductSupplierLocation[]

  @@index([serviceProductId], map: "SvcProductLocation_ProductID_idx")
  @@index([serviceProductLocationTypeId], map: "SvcProductLocation_TypeID_idx")
  @@index([countryId], map: "SvcProductLocation_CountryID_idx")
  @@index([cityId], map: "SvcProductLocation_CityID_idx")
  @@index([areaId], map: "SvcProductLocation_AreaID_idx")
  @@index([commonStatusId], map: "SvcProductLocation_CommonStatusID_idx")
  @@map("ServiceProductLocation")
}

/// A supplier's own location for a Service Product — may optionally reference a canonical ServiceProductLocation, or stand alone with its own address/geo.
model ServiceProductSupplierLocation {
  serviceProductSupplierLocationId BigInt    @id @default(autoincrement()) @map("ServiceProductSupplierLocationID")
  serviceProductSupplierId         BigInt    @map("ServiceProductSupplierID")
  serviceProductLocationId         BigInt?   @map("ServiceProductLocationID")
  serviceProductLocationTypeId     BigInt    @map("ServiceProductLocationTypeID")
  countryId                        Int       @map("CountryID")
  regionId                         Int?      @map("RegionID")
  cityId                           Int?      @map("CityID")
  areaId                           Int?      @map("AreaID")
  supplierLocationCode             String?   @map("SupplierLocationCode") @db.VarChar(100)
  supplierLocationName             String    @map("SupplierLocationName") @db.VarChar(250)
  supplierLocationReference        String?   @map("SupplierLocationReference") @db.VarChar(200)
  addressLine1                     String?   @map("AddressLine1") @db.VarChar(500)
  addressLine2                     String?   @map("AddressLine2") @db.VarChar(500)
  postalCode                       String?   @map("PostalCode") @db.VarChar(30)
  latitude                         Decimal?  @map("Latitude") @db.Decimal(10, 7)
  longitude                        Decimal?  @map("Longitude") @db.Decimal(10, 7)
  supplierGooglePlaceId            String?   @map("SupplierGooglePlaceID") @db.VarChar(200)
  locationInstructions             String?   @map("LocationInstructions") @db.VarChar(2000)
  isPickupAvailable                Boolean   @default(false) @map("IsPickupAvailable")
  isDropoffAvailable               Boolean   @default(false) @map("IsDropoffAvailable")
  isMeetingPoint                   Boolean   @default(false) @map("IsMeetingPoint")
  isPrimary                        Boolean   @default(false) @map("IsPrimary")
  isAvailable                      Boolean   @default(true) @map("IsAvailable")
  displayOrder                     Int       @default(0) @map("DisplayOrder")
  commonStatusId                   BigInt    @map("CommonStatusID")
  isActive                         Boolean   @default(true) @map("IsActive")
  createdBy                        Int       @map("CreatedBy")
  createdDtTm                      DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                       Int?      @map("ModifiedBy")
  modifiedDtTm                     DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  supplierLink ServiceProductSupplier     @relation(fields: [serviceProductSupplierId], references: [serviceProductSupplierId], onDelete: Cascade)
  location     ServiceProductLocation?    @relation(fields: [serviceProductLocationId], references: [serviceProductLocationId], onDelete: SetNull)
  locationType ServiceProductLocationType @relation(fields: [serviceProductLocationTypeId], references: [serviceProductLocationTypeId], onDelete: Restrict)
  country      Country                    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  region       Region?                    @relation(fields: [regionId], references: [regionId], onDelete: SetNull)
  city         City?                      @relation(fields: [cityId], references: [cityId], onDelete: SetNull)
  area         Area?                      @relation(fields: [areaId], references: [areaId], onDelete: SetNull)
  commonStatus CommonStatus               @relation(fields: [commonStatusId], references: [commonStatusId], onDelete: Restrict)

  @@index([serviceProductSupplierId], map: "SvcProductSupplierLoc_SupplierLinkID_idx")
  @@index([serviceProductLocationId], map: "SvcProductSupplierLoc_LocationID_idx")
  @@index([serviceProductLocationTypeId], map: "SvcProductSupplierLoc_TypeID_idx")
  @@index([countryId], map: "SvcProductSupplierLoc_CountryID_idx")
  @@index([cityId], map: "SvcProductSupplierLoc_CityID_idx")
  @@index([commonStatusId], map: "SvcProductSupplierLoc_CommonStatusID_idx")
  @@map("ServiceProductSupplierLocation")
}

/// Media (photos/videos/PDFs) for a Service Product — Cover, Gallery, Map, Location, …
model ServiceProductMedia {
  serviceProductMediaId BigInt    @id @default(autoincrement()) @map("ServiceProductMediaID")
  serviceProductId      BigInt    @map("ServiceProductID")
  mediaTypeId           BigInt    @map("MediaTypeID")
  mediaCategoryId       BigInt    @map("MediaCategoryID")
  mediaUrl              String    @map("MediaURL") @db.VarChar(1000)
  thumbnailUrl          String?   @map("ThumbnailURL") @db.VarChar(1000)
  mediaTitle            String?   @map("MediaTitle") @db.VarChar(250)
  mediaDescription      String?   @map("MediaDescription") @db.VarChar(1000)
  altText               String?   @map("AltText") @db.VarChar(500)
  fileName              String?   @map("FileName") @db.VarChar(250)
  fileExtension         String?   @map("FileExtension") @db.VarChar(20)
  mimeType              String?   @map("MimeType") @db.VarChar(100)
  fileSize              BigInt?   @map("FileSize")
  width                 Int?      @map("Width")
  height                Int?      @map("Height")
  durationSeconds       Int?      @map("DurationSeconds")
  isPrimary             Boolean   @default(false) @map("IsPrimary")
  displayOrder          Int       @default(0) @map("DisplayOrder")
  commonStatusId        BigInt    @map("CommonStatusID")
  isActive              Boolean   @default(true) @map("IsActive")
  createdBy             Int       @map("CreatedBy")
  createdDtTm           DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy            Int?      @map("ModifiedBy")
  modifiedDtTm          DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceProduct ServiceProduct @relation(fields: [serviceProductId], references: [serviceProductId], onDelete: Cascade)
  mediaType      MediaType      @relation(fields: [mediaTypeId], references: [mediaTypeId], onDelete: Restrict)
  mediaCategory  MediaCategory  @relation(fields: [mediaCategoryId], references: [mediaCategoryId], onDelete: Restrict)
  commonStatus   CommonStatus   @relation(fields: [commonStatusId], references: [commonStatusId], onDelete: Restrict)

  @@index([serviceProductId], map: "SvcProductMedia_ProductID_idx")
  @@index([mediaTypeId], map: "SvcProductMedia_MediaTypeID_idx")
  @@index([mediaCategoryId], map: "SvcProductMedia_MediaCategoryID_idx")
  @@index([commonStatusId], map: "SvcProductMedia_CommonStatusID_idx")
  @@map("ServiceProductMedia")
}

/// INCLUSION / EXCLUSION type lookup. Global.
model InclusionExclusionType {
  inclusionExclusionTypeId BigInt    @id @default(autoincrement()) @map("InclusionExclusionTypeID")
  typeCode                 String    @unique @map("TypeCode") @db.VarChar(50)
  typeName                 String    @map("TypeName") @db.VarChar(100)
  isActive                 Boolean   @default(true) @map("IsActive")
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy               Int?      @map("ModifiedBy")
  modifiedDtTm             DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  inclusionExclusions ServiceProductInclusionExclusion[]

  @@map("InclusionExclusionType")
}

/// Inclusion/exclusion line-item type lookup — Transport, Meal, Ticket, Guide, … Global.
/// Also reused as the Quantity unit on ServiceProductInclusionExclusion (Person, Vehicle, Meal, Ticket, …).
model ServiceProductItemType {
  serviceProductItemTypeId BigInt    @id @default(autoincrement()) @map("ServiceProductItemTypeID")
  itemTypeCode             String    @unique @map("ItemTypeCode") @db.VarChar(50)
  itemTypeName             String    @map("ItemTypeName") @db.VarChar(100)
  displayOrder             Int       @default(0) @map("DisplayOrder")
  isActive                 Boolean   @default(true) @map("IsActive")
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy               Int?      @map("ModifiedBy")
  modifiedDtTm             DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  inclusionExclusionsAsItem ServiceProductInclusionExclusion[] @relation("InclExclItemType")
  inclusionExclusionsAsUnit ServiceProductInclusionExclusion[] @relation("InclExclUnitType")

  @@map("ServiceProductItemType")
}

/// What's included / excluded in a Service Product — item, optional quantity + unit, mandatory flag.
model ServiceProductInclusionExclusion {
  serviceProductInclusionExclusionId BigInt    @id @default(autoincrement()) @map("ServiceProductInclusionExclusionID")
  serviceProductId                   BigInt    @map("ServiceProductID")
  inclusionExclusionTypeId           BigInt    @map("InclusionExclusionTypeID")
  itemTypeId                         BigInt?   @map("ItemTypeID")
  itemName                           String    @map("ItemName") @db.VarChar(250)
  description                        String?   @map("Description") @db.VarChar(1000)
  quantity                           Decimal?  @map("Quantity") @db.Decimal(10, 2)
  unitId                             BigInt?   @map("UnitID")
  isMandatory                        Boolean   @default(false) @map("IsMandatory")
  displayOrder                       Int       @default(0) @map("DisplayOrder")
  commonStatusId                     BigInt    @map("CommonStatusID")
  isActive                           Boolean   @default(true) @map("IsActive")
  createdBy                          Int       @map("CreatedBy")
  createdDtTm                        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                         Int?      @map("ModifiedBy")
  modifiedDtTm                       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  serviceProduct         ServiceProduct          @relation(fields: [serviceProductId], references: [serviceProductId], onDelete: Cascade)
  inclusionExclusionType InclusionExclusionType  @relation(fields: [inclusionExclusionTypeId], references: [inclusionExclusionTypeId], onDelete: Restrict)
  itemType               ServiceProductItemType? @relation("InclExclItemType", fields: [itemTypeId], references: [serviceProductItemTypeId], onDelete: SetNull)
  unit                   ServiceProductItemType? @relation("InclExclUnitType", fields: [unitId], references: [serviceProductItemTypeId], onDelete: SetNull)
  commonStatus           CommonStatus            @relation(fields: [commonStatusId], references: [commonStatusId], onDelete: Restrict)

  @@index([serviceProductId], map: "SvcProductInclExcl_ProductID_idx")
  @@index([inclusionExclusionTypeId], map: "SvcProductInclExcl_TypeID_idx")
  @@index([itemTypeId], map: "SvcProductInclExcl_ItemTypeID_idx")
  @@index([unitId], map: "SvcProductInclExcl_UnitID_idx")
  @@index([commonStatusId], map: "SvcProductInclExcl_CommonStatusID_idx")
  @@map("ServiceProductInclusionExclusion")
}
