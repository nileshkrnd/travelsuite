  isActive                 Boolean   @default(true) @map("IsActive")
  validFrom                DateTime? @map("ValidFrom") @db.Date
  validTo                  DateTime? @map("ValidTo") @db.Date
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)

  propertySupplier PropertySupplier @relation(fields: [propertySupplierId], references: [propertySupplierId], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([propertySupplierId, userId], map: "SupplierPropertyAccess_PropertySupplier_User_key")
  @@index([userId], map: "SupplierPropertyAccess_UserID_idx")
  @@index([tenantId, companyId], map: "SupplierPropertyAccess_TenantID_CompanyID_idx")
  @@map("SupplierPropertyAccess")
}

/// Supplier contract for a Property — rates/terms agreement, uploaded document, validity window.
model PropertyContract {
  propertyContractId BigInt    @id @default(autoincrement()) @map("PropertyContractID")
  tenantId           Int       @map("TenantID")
  companyId          Int       @map("CompanyID")
  propertyId         Int       @map("PropertyID")
  supplierId         BigInt    @map("SupplierID")
  contractNumber     String    @map("ContractNumber") @db.VarChar(100)
  contractName       String    @map("ContractName") @db.VarChar(200)
  contractTypeId     BigInt    @map("ContractTypeID")
  startDate          DateTime  @map("StartDate") @db.Date
  endDate            DateTime  @map("EndDate") @db.Date
  contractCurrencyId Int       @map("ContractCurrencyID")
  contractStatusId   BigInt    @map("ContractStatusID")
  contractVersion    Int       @default(1) @map("ContractVersion")
  signedDate         DateTime? @map("SignedDate") @db.Date
  signedByEmployeeId Int?      @map("SignedByEmployeeID")
  supplierContactId  BigInt?   @map("SupplierContactID")
  paymentTerms       String?   @map("PaymentTerms") @db.Text
  generalTerms       String?   @map("GeneralTerms") @db.Text
  remarks            String?   @map("Remarks") @db.Text
  contractFileUrl    String?   @map("ContractFileUrl") @db.VarChar(500)
  contractFileName   String?   @map("ContractFileName") @db.VarChar(255)
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  property             Property                             @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  supplier             Supplier                             @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  contractType         ContractType                         @relation(fields: [contractTypeId], references: [contractTypeId], onDelete: Restrict)
  contractStatus       ContractStatus                       @relation(fields: [contractStatusId], references: [contractStatusId], onDelete: Restrict)
  currency             Currency                             @relation(fields: [contractCurrencyId], references: [currencyId], onDelete: Restrict)
  signedByEmployee     Employee?                            @relation(fields: [signedByEmployeeId], references: [employeeId], onDelete: SetNull)
  supplierContact      SupplierUser?                        @relation(fields: [supplierContactId], references: [supplierUserId], onDelete: SetNull)
  seasonPeriods        PropertyContractSeasonPeriod[]
  ratePlans            PropertyContractRatePlan[]
  rates                PropertyContractRate[]
  inventories          PropertyContractInventory[]
  supplements          PropertyContractSupplement[]
  childPolicies        PropertyContractChildPolicy[]
  cancellationPolicies PropertyContractCancellationPolicy[]
  promotions           PropertyContractPromotion[]
  stopSales            PropertyContractStopSale[]
  blackouts            PropertyContractBlackout[]
  marketRules          PropertyContractMarketRule[]
  contractTaxes        PropertyContractTax[]

  @@unique([tenantId, propertyId, contractNumber], map: "PropertyContract_Tenant_Property_Number_key")
  @@index([tenantId, companyId], map: "PropertyContract_TenantID_CompanyID_idx")
  @@index([propertyId], map: "PropertyContract_PropertyID_idx")
  @@index([supplierId], map: "PropertyContract_SupplierID_idx")
  @@index([contractStatusId], map: "PropertyContract_ContractStatusID_idx")
  @@map("PropertyContract")
}

/// Property-level season definition (Low / High / Peak, …). Tenant + Company + Property scoped.
model PropertySeason {
  propertySeasonId BigInt    @id @default(autoincrement()) @map("PropertySeasonID")
  tenantId         Int       @map("TenantID")
  companyId        Int       @map("CompanyID")
  propertyId       Int       @map("PropertyID")
  /// LOW | HIGH | PEAK | custom codes
  seasonCode       String    @map("SeasonCode") @db.VarChar(50)
  seasonName       String    @map("SeasonName") @db.VarChar(100)
  displayOrder     Int       @default(0) @map("DisplayOrder")
  isActive         Boolean   @default(true) @map("IsActive")
  createdBy        Int       @map("CreatedBy")
  createdDtTm      DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy       Int?      @map("ModifiedBy")
  modifiedDtTm     DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  property             Property                             @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  seasonPeriods        PropertyContractSeasonPeriod[]
  cancellationPolicies PropertyContractCancellationPolicy[]

  @@unique([tenantId, propertyId, seasonCode], map: "PropertySeason_Tenant_Property_Code_key")
  @@index([tenantId, companyId], map: "PropertySeason_TenantID_CompanyID_idx")
  @@index([propertyId], map: "PropertySeason_PropertyID_idx")
  @@map("PropertySeason")
}

/// Date range linking a PropertyContract to a PropertySeason (e.g. High Season 01-Jun → 31-Aug).
model PropertyContractSeasonPeriod {
  propertyContractSeasonPeriodId BigInt    @id @default(autoincrement()) @map("PropertyContractSeasonPeriodID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
  propertyContractId             BigInt    @map("PropertyContractID")
  propertySeasonId               BigInt    @map("PropertySeasonID")
  fromDate                       DateTime  @map("FromDate") @db.Date
  toDate                         DateTime  @map("ToDate") @db.Date
  /// Default minimum length of stay for this season period — calendar falls back to this per date unless daily-overridden.
  minLengthOfStay                Int?      @map("MinLengthOfStay")
  /// Default maximum length of stay for this season period — calendar falls back to this per date unless daily-overridden.
  maxLengthOfStay                Int?      @map("MaxLengthOfStay")
  isActive                       Boolean   @default(true) @map("IsActive")
  createdBy                      Int       @map("CreatedBy")
  createdDtTm                    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                     Int?      @map("ModifiedBy")
  modifiedDtTm                   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  propertyContract    PropertyContract            @relation(fields: [propertyContractId], references: [propertyContractId], onDelete: Cascade)
  propertySeason      PropertySeason              @relation(fields: [propertySeasonId], references: [propertySeasonId], onDelete: Restrict)
  contractRates       PropertyContractRate[]
  contractInventories PropertyContractInventory[]

  @@index([tenantId, companyId], map: "PropertyContractSeasonPeriod_TenantID_CompanyID_idx")
  @@index([propertyContractId], map: "PropertyContractSeasonPeriod_PropertyContractID_idx")
  @@index([propertySeasonId], map: "PropertyContractSeasonPeriod_PropertySeasonID_idx")
  @@map("PropertyContractSeasonPeriod")
}

/// Rate plan on a property contract — FIT-BB, Corporate-HB, … Tenant + Company + Contract scoped.
model PropertyContractRatePlan {
  propertyContractRatePlanId BigInt    @id @default(autoincrement()) @map("PropertyContractRatePlanID")
  tenantId                   Int       @map("TenantID")
  companyId                  Int       @map("CompanyID")
