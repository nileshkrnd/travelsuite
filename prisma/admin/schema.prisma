/// Status-type catalog — the entity a status lifecycle applies to (Tenant Registration, Property, Service Product, …).
model CommonStatusType {
  commonStatusTypeId BigInt    @id @default(autoincrement()) @map("CommonStatusTypeID")
  tenantId           Int?      @map("TenantID")
  companyId          Int?      @map("CompanyID")
  statusTypeCode     String    @map("StatusTypeCode") @db.VarChar(50)
  statusTypeName     String    @map("StatusTypeName") @db.VarChar(100)
  description        String?   @map("Description") @db.VarChar(500)
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  statuses CommonStatus[]

  @@unique([tenantId, companyId, statusTypeCode], map: "CommonStatusType_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "CommonStatusType_TenantID_CompanyID_idx")
  @@map("CommonStatusType")
}

/// A status value within a status-type lifecycle (Draft, Under Review, Approved, Published, …).
model CommonStatus {
  commonStatusId     BigInt    @id @default(autoincrement()) @map("CommonStatusID")
  commonStatusTypeId BigInt    @map("CommonStatusTypeID")
  tenantId           Int?      @map("TenantID")
  companyId          Int?      @map("CompanyID")
  statusCode         String    @map("StatusCode") @db.VarChar(50)
  statusName         String    @map("StatusName") @db.VarChar(100)
  description        String?   @map("Description") @db.VarChar(500)
  displayOrder       Int       @default(0) @map("DisplayOrder")
  isInitial          Boolean   @default(false) @map("IsInitial")
  isFinal            Boolean   @default(false) @map("IsFinal")
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  statusType CommonStatusType @relation(fields: [commonStatusTypeId], references: [commonStatusTypeId], onDelete: Restrict)

  serviceProducts                   ServiceProduct[]
  serviceProductOptions             ServiceProductOption[]
  serviceProductVariants            ServiceProductVariant[]
  serviceProductStatusHistoryFrom   ServiceProductStatusHistory[]      @relation("ServiceProductStatusHistoryFrom")
  serviceProductStatusHistoryTo     ServiceProductStatusHistory[]      @relation("ServiceProductStatusHistoryTo")
  serviceProductAvailabilities      ServiceProductAvailability[]
  serviceProductSchedules           ServiceProductSchedule[]
  serviceProductRates               ServiceProductRate[]
  serviceProductLocations           ServiceProductLocation[]
  serviceProductSupplierLocations   ServiceProductSupplierLocation[]
  serviceProductMedia               ServiceProductMedia[]
  serviceProductInclusionExclusions ServiceProductInclusionExclusion[]

  @@unique([tenantId, companyId, commonStatusTypeId, statusCode], map: "CommonStatus_Tenant_Company_Type_Code_key")
  @@index([tenantId, companyId], map: "CommonStatus_TenantID_CompanyID_idx")
  @@index([commonStatusTypeId], map: "CommonStatus_StatusTypeID_idx")
  @@map("CommonStatus")
}

/// One configuration row per Service Type — which optional product attributes apply (duration, pricing model, pax, pickup/dropoff, …).
