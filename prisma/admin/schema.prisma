/// Tax master — a specific tax definition (e.g. Qatar VAT 5%), optionally scoped to a country/region and tenant.
model Tax {
  taxId              BigInt    @id @default(autoincrement()) @map("TaxID")
  /// NULL = platform-wide default tax, usable by any tenant.
  tenantId           Int?      @map("TenantID")
  /// NULL = tenant-wide, not restricted to one company.
  companyId          Int?      @map("CompanyID")
  taxTypeId          BigInt    @map("TaxTypeID")
  taxCode            String    @unique @map("TaxCode") @db.VarChar(50)
  taxName            String    @map("TaxName") @db.VarChar(200)
  /// Applicable country; NULL = not country-restricted.
  countryId          Int?      @map("CountryID")
  /// Applicable region; NULL = not region-restricted.
  regionId           Int?      @map("RegionID")
  /// PERCENTAGE | FIXED
  calculationType    String    @map("CalculationType") @db.VarChar(30)
  defaultRate        Decimal?  @map("DefaultRate") @db.Decimal(18, 4)
  defaultAmount      Decimal?  @map("DefaultAmount") @db.Decimal(18, 4)
  /// Currency for a fixed-amount tax.
  currencyId         Int?      @map("CurrencyID")
  /// ROOM_RATE | ROOM_NIGHT | PERSON | PERSON_NIGHT | MEAL | SUPPLEMENT | TOTAL
  applicationBasis   String    @map("ApplicationBasis") @db.VarChar(50)
  isInclusiveDefault Boolean   @default(false) @map("IsInclusiveDefault")
  isCompound         Boolean   @default(false) @map("IsCompound")
  effectiveFrom      DateTime? @map("EffectiveFrom") @db.Date
  effectiveTo        DateTime? @map("EffectiveTo") @db.Date
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  taxType       TaxType               @relation(fields: [taxTypeId], references: [taxTypeId], onDelete: Restrict)
  country       Country?              @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  region        Region?               @relation(fields: [regionId], references: [regionId], onDelete: Restrict)
  currency      Currency?             @relation("TaxCurrency", fields: [currencyId], references: [currencyId], onDelete: Restrict)
  contractTaxes PropertyContractTax[]

  @@index([tenantId, companyId], map: "Tax_TenantID_CompanyID_idx")
  @@index([taxTypeId], map: "Tax_TaxTypeID_idx")
  @@index([countryId], map: "Tax_CountryID_idx")
  @@index([regionId], map: "Tax_RegionID_idx")
  @@index([currencyId], map: "Tax_CurrencyID_idx")
  @@map("Tax")
}

