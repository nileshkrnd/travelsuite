  serviceTypeConfigurationId BigInt    @id @default(autoincrement()) @map("ServiceTypeConfigurationID")
  tenantId                   Int?      @map("TenantID")
  companyId                  Int?      @map("CompanyID")
  serviceTypeId              BigInt    @map("ServiceTypeID")
  isDurationApplicable       Boolean   @default(false) @map("IsDurationApplicable")
  isBookingModelApplicable   Boolean   @default(false) @map("IsBookingModelApplicable")
  isPricingModelApplicable   Boolean   @default(false) @map("IsPricingModelApplicable")
  isPaxApplicable            Boolean   @default(false) @map("IsPaxApplicable")
  isAgeApplicable            Boolean   @default(false) @map("IsAgeApplicable")
  isPickupApplicable         Boolean   @default(false) @map("IsPickupApplicable")
