/// Amenity/Facility Category master — classifies amenities & facilities as Property, Room, or Both. Global.
model AmenityFacilityCategory {
  amenityFacilityCategoryId BigInt    @id @default(autoincrement()) @map("AmenityFacilityCategoryID")
  categoryCode              String    @unique @map("CategoryCode") @db.VarChar(50)
  categoryName              String    @map("CategoryName") @db.VarChar(150)
  /// PROPERTY | ROOM | BOTH
  applicableTo              String    @map("ApplicableTo") @db.VarChar(50)
  description               String?   @map("Description") @db.Text
  displayOrder              Int       @default(0) @map("DisplayOrder")
  isActive                  Boolean   @default(true) @map("IsActive")
  createdBy                 Int       @map("CreatedBy")
  createdDtTm               DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy                Int?      @map("ModifiedBy")
  modifiedDtTm              DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted                 Boolean   @default(false) @map("IsDeleted")

  amenities  Amenity[]
  facilities Facility[]

  @@map("AmenityFacilityCategoryMaster")
}

