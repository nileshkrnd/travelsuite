  amenityCode               String    @unique @map("AmenityCode") @db.VarChar(50)
  amenityName               String    @map("AmenityName") @db.VarChar(250)
  description               String?   @map("Description") @db.Text
  icon                      String?   @map("Icon") @db.VarChar(255)
  isFilterable              Boolean   @default(false) @map("IsFilterable")
  displayOrder              Int       @default(0) @map("DisplayOrder")
  isActive                  Boolean   @default(true) @map("IsActive")
  createdBy                 Int       @map("CreatedBy")
  createdDtTm               DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy                Int?      @map("ModifiedBy")
  modifiedDtTm              DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted                 Boolean   @default(false) @map("IsDeleted")

  category      AmenityFacilityCategory @relation(fields: [amenityFacilityCategoryId], references: [amenityFacilityCategoryId], onDelete: Restrict)
  propertyLinks PropertyAmenity[]

  @@index([amenityFacilityCategoryId], map: "Amenity_AmenityFacilityCategoryID_idx")
  @@map("AmenityMaster")
}

