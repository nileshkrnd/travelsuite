/// KlyraAdmin — masters & configuration (Tenant, User, Company, geo, aviation, …).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMINCNX_URL")
}

/// Tenant master — primary org entry point (holding / legal entity).
model Tenant {
  tenantId            Int       @id @default(autoincrement()) @map("TenantID")
  /// Stable app string id (e.g. tenant_regency) used by mock/company FKs until those move to DB.
  tenantUid           String    @unique @map("TenantUid") @db.VarChar(100)
  tenantCode          String    @unique @map("TenantCode") @db.VarChar(100)
  tenantName          String    @map("TenantName") @db.VarChar(200)
  groupName           String    @map("GroupName") @db.VarChar(200)
  defaultCurrency     String    @map("DefaultCurrency") @db.VarChar(10)
  supportedCurrencies String    @map("SupportedCurrencies") @db.VarChar(200)
  defaultLocale       String    @default("en") @map("DefaultLocale") @db.VarChar(10)
  supportedLocales    String    @default("en") @map("SupportedLocales") @db.VarChar(100)
  primaryColor        String    @map("PrimaryColor") @db.VarChar(20)
  logoUrl             String    @default("") @map("LogoUrl") @db.VarChar(500)
  addressLine1        String    @map("AddressLine1") @db.VarChar(200)
  addressLine2        String?   @map("AddressLine2") @db.VarChar(200)
  country             String    @map("Country") @db.VarChar(10)
  city                String    @map("City") @db.VarChar(100)
  zip                 String    @map("Zip") @db.VarChar(30)
  timezone            String    @map("Timezone") @db.VarChar(100)
  email               String    @map("Email") @db.VarChar(200)
  dialCode            String    @map("DialCode") @db.VarChar(20)
  phone               String    @map("Phone") @db.VarChar(50)
  status              String    @default("active") @map("Status") @db.VarChar(20)
  createdBy           Int       @map("CreatedBy")
  createdDtTm         DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy          Int?      @map("ModifiedBy")
  modifiedDtTm        DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  moduleAccess  SubscriptionModuleAccess[]
  tenantCultures TenantCulture[]

  @@map("Tenant")
}

/// Global Culture master — languages/locales assignable to tenants (en, ar, es, …).
model Culture {
  cultureId    Int       @id @default(autoincrement()) @map("CultureID")
  cultureCode  String    @unique @map("CultureCode") @db.VarChar(10)
  cultureName  String    @map("CultureName") @db.VarChar(200)
  /// Text direction: "ltr" | "rtl"
  direction    String    @default("ltr") @map("Direction") @db.VarChar(10)
  isActive     Boolean   @default(true) @map("IsActive")
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  tenantCultures TenantCulture[]

  @@map("Culture")
}

/// Cultures enabled for a tenant — one row marked IsDefault.
model TenantCulture {
  tenantCultureId Int       @id @default(autoincrement()) @map("TenantCultureID")
  tenantId        Int       @map("TenantID")
  cultureId       Int       @map("CultureID")
  isDefault       Boolean   @default(false) @map("IsDefault")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  culture Culture @relation(fields: [cultureId], references: [cultureId], onDelete: Restrict)

  @@unique([tenantId, cultureId], map: "TenantCulture_Tenant_Culture_key")
  @@index([tenantId], map: "TenantCulture_TenantID_idx")
  @@index([cultureId], map: "TenantCulture_CultureID_idx")
  @@map("TenantCulture")
}

/// Global Country master — not scoped to Tenant or Company.
model Country {
  countryId    Int       @id @default(autoincrement()) @map("CountryID")
  countryCode  String    @unique @map("CountryCode") @db.VarChar(10)
  countryName  String    @map("CountryName") @db.VarChar(200)
  dialCode     String    @map("DialCode") @db.VarChar(20)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  cities    City[]
  airports  Airport[]
  companies Company[]
  branches  Branch[]
  employees Employee[]

  @@map("Country")
}

/// Global City master — belongs to Country only (no Tenant / Company).
model City {
  cityId       Int       @id @default(autoincrement()) @map("CityID")
  countryId    Int       @map("CountryID")
  cityCode     String    @map("CityCode") @db.VarChar(100)
  cityName     String    @map("CityName") @db.VarChar(200)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country   Country    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  airports  Airport[]
  companies Company[]
  branches  Branch[]
  employees Employee[]

  @@unique([countryId, cityCode], map: "City_Country_Code_key")
  @@index([countryId], map: "City_CountryID_idx")
  @@map("City")
}

/// Global Currency master — not scoped to Tenant or Company.
model Currency {
  currencyId        Int       @id @default(autoincrement()) @map("CurrencyID")
  currencyCode      String    @unique @map("CurrencyCode") @db.VarChar(10)
  currencyName      String    @map("CurrencyName") @db.VarChar(200)
  symbol            String    @default("") @map("Symbol") @db.VarChar(20)
  smallCurrencyName String    @map("SmallCurrencyName") @db.VarChar(100)
  significantDigit  Int       @default(2) @map("SignificantDigit")
  status            String    @default("active") @map("Status") @db.VarChar(20)
  createdBy         Int       @map("CreatedBy")
  createdDtTm       DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy        Int?      @map("ModifiedBy")
  modifiedDtTm      DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  companies Company[]

  @@map("Currency")
}

/// Global Region master — not scoped to Tenant or Company.
model Region {
  regionId     Int       @id @default(autoincrement()) @map("RegionID")
  regionCode   String    @unique @map("RegionCode") @db.VarChar(100)
  regionName   String    @map("RegionName") @db.VarChar(200)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  @@map("Region")
}

/// User master — UserTypeID enum:
/// 1 SuperAdmin, 2 TenantAdmin, 3 InternalEmployee, 4 AgencyUser,
/// 5 SubAgencyUser, 6 CorporateUser, 7 CashCustomer, 8 SupplierUser.
/// TenantID / CompanyID still scope the workspace.
model User {
  userId                 Int       @id @default(autoincrement()) @map("UserID")
  username               String    @unique @map("Username") @db.VarChar(200)
  passwordHash           String    @map("PasswordHash") @db.VarChar(500)
  userDisplayName        String    @map("UserDisplayName") @db.VarChar(200)
  /// Enum: 1=SuperAdmin … 8=SupplierUser (see types/user-type.ts).
  userTypeId             Int       @default(3) @map("UserTypeID")
  tenantId               Int       @default(0) @map("TenantID")
  companyId              Int       @default(0) @map("CompanyID")
  lastLoggedInDtTm       DateTime? @map("LastLoggedInDtTm") @db.Timestamptz(6)
  lastPasswordChangeDtTm DateTime? @map("LastPasswordChangeDtTm") @db.Timestamptz(6)
  createdBy              Int       @map("CreatedBy")
  createDtTm             DateTime  @default(now()) @map("CreateDtTm") @db.Timestamptz(6)
  modifiedBy             Int?      @map("ModifiedBy")
  modifiedDtTm           DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  isActive               Boolean   @default(true) @map("IsActive")

  employee Employee?

  @@index([tenantId, companyId], map: "User_TenantID_CompanyID_idx")
  @@index([userTypeId], map: "User_UserTypeID_idx")
  @@map("User")
}

/// Access Role master — scoped by TenantID / CompanyID (same rules as User).
/// Platform Super Admin manages T0C0 roles; tenants manage roles under their TenantID.
model AccessRole {
  accessRoleId   Int       @id @default(autoincrement()) @map("AccessRoleID")
  accessRoleName String    @map("AccessRoleName") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  tenantId       Int       @map("TenantID")
  companyId      Int       @map("CompanyID")

  employees            Employee[]
  menuPermissions      TenantAccessRoleMenuPermission[]

  @@unique([tenantId, companyId, accessRoleName], map: "AccessRole_Tenant_Company_Name_key")
  @@index([tenantId, companyId], map: "AccessRole_TenantID_CompanyID_idx")
  @@map("AccessRole")
}

/// Global Airline Type master — Super Admin / Tenant Configuration only.
model AirlineType {
  airlineTypeId   Int       @id @default(autoincrement()) @map("AirlineTypeID")
  airlineTypeName String    @unique @map("AirlineTypeName") @db.VarChar(100)
  isActive        Boolean   @default(true) @map("IsActive")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  airlines Airline[]

  @@map("AirlineType")
}

/// Global Airline master — Super Admin / Tenant Configuration only.
model Airline {
  airlineId          Int       @id @default(autoincrement()) @map("AirlineID")
  airlineTypeId      Int       @map("AirlineTypeID")
  airlineCode        String    @unique @map("AirlineCode") @db.VarChar(3)
  airlineName        String    @map("AirlineName") @db.VarChar(200)
  airlineNumericCode Int?      @map("AirlineNumericCode")
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  pnrMaxDigit        Int       @map("PNRMaxDigit")
  tktMaxDigit        Int       @map("TKTMaxDigit")
  isTktNumberOnly    Boolean   @default(false) @map("IsTKTNumberOnly")

  airlineType AirlineType @relation(fields: [airlineTypeId], references: [airlineTypeId], onDelete: Restrict)

  @@index([airlineTypeId], map: "Airline_AirlineTypeID_idx")
  @@map("Airline")
}

/// Global Airport master — Super Admin / Tenant Configuration only.
/// ParentAirportID = 0 means no parent airport.
model Airport {
  airportId       Int       @id @default(autoincrement()) @map("AirportID")
  airportCode     String    @unique @map("AirportCode") @db.VarChar(3)
  airportName     String    @map("AirportName") @db.VarChar(300)
  countryId       Int       @map("CountryID")
  cityId          Int       @map("CityID")
  parentAirportId Int       @default(0) @map("ParentAirportID")
  latitude        String?   @map("Latitude") @db.VarChar(20)
  longitude       String?   @map("Longitude") @db.VarChar(20)
  isActive        Boolean?  @default(true) @map("IsActive")
  createdBy       Int?      @map("CreatedBy")
  createdDtTm     DateTime? @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country Country @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city    City    @relation(fields: [cityId], references: [cityId], onDelete: Restrict)

  @@index([countryId], map: "Airport_CountryID_idx")
  @@index([cityId], map: "Airport_CityID_idx")
  @@map("Airport")
}

/// Company master — scoped by TenantID (tenant workspace Administration).
model Company {
  companyId                  Int       @id @default(autoincrement()) @map("CompanyID")
  /// Stable app string id (e.g. company_leisure) for branch/employee FKs.
  companyUid                 String    @unique @map("CompanyUid") @db.VarChar(100)
  companyGroupId             Int?      @map("CompanyGroupID")
  companyCode                String    @map("CompanyCode") @db.VarChar(20)
  companyName                String    @map("CompanyName") @db.VarChar(200)
  address1                   String    @map("Address1") @db.VarChar(200)
  address2                   String    @default("") @map("Address2") @db.VarChar(200)
  countryId                  Int       @map("CountryID")
  cityId                     Int       @map("CityID")
  currencyId                 Int       @map("CurrencyID")
  zipCode                    String    @map("ZipCode") @db.VarChar(50)
  countryDialCode            String    @map("CountryDialCode") @db.VarChar(5)
  contactNumber              String?   @map("ContactNumber") @db.VarChar(20)
  fax                        String?   @map("Fax") @db.VarChar(50)
  contactPerson              String?   @map("ContactPerson") @db.VarChar(200)
  emailAddress               String?   @map("EmailAddress") @db.VarChar(200)
  isActive                   Boolean   @default(true) @map("IsActive")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  isRoundOff                 Boolean   @default(false) @map("IsRoundOff")
  noOfSignificantDigits      Int       @default(2) @map("NoOfSignificantDigits")
  isDisplayNumberInThousands Boolean?  @map("IsDisplayNumberInThousands")
  tenantId                   Int       @map("TenantID")
  companyLogo                String    @default("") @map("CompanyLogo") @db.VarChar(100)
  companyFavIcon             String    @default("") @map("CompanyFavIcon") @db.VarChar(100)

  country   Country    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city      City       @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  currency  Currency   @relation(fields: [currencyId], references: [currencyId], onDelete: Restrict)
  branches  Branch[]
  employees Employee[]

  @@unique([tenantId, companyCode], map: "Company_Tenant_Code_key")
  @@index([tenantId], map: "Company_TenantID_idx")
  @@index([countryId], map: "Company_CountryID_idx")
  @@index([cityId], map: "Company_CityID_idx")
  @@index([currencyId], map: "Company_CurrencyID_idx")
  @@map("Company")
}

/// Branch Type master — Super Admin / Tenant Configuration only (e.g. Head Office, Branch Office).
/// Branch type master — scoped by TenantID + CompanyID.
model BranchType {
  branchTypeId   Int       @id @default(autoincrement()) @map("BranchTypeID")
  branchTypeName String    @map("BranchTypeName") @db.VarChar(100)
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  tenantId       Int       @map("TenantID")
  companyId      Int       @map("CompanyID")

  branches Branch[]

  @@unique([tenantId, companyId, branchTypeName], map: "BranchType_Tenant_Company_Name_key")
  @@index([tenantId, companyId], map: "BranchType_TenantID_CompanyID_idx")
  @@map("BranchType")
}

/// Branch master — scoped by TenantID + CompanyID.
model Branch {
  branchId        Int       @id @default(autoincrement()) @map("BranchID")
  /// Stable app string id (e.g. branch_mumbai) for employee FKs.
  branchUid       String    @unique @map("BranchUid") @db.VarChar(100)
  branchTypeId    Int       @map("BranchTypeID")
  branchName      String    @map("BranchName") @db.VarChar(100)
  companyId       Int       @map("CompanyID")
  /// Denormalized TenantID (from Company) for tenant-scoped lists.
  tenantId        Int       @map("TenantID")
  address1        String    @map("Address1") @db.VarChar(200)
  address2        String?   @map("Address2") @db.VarChar(200)
  countryId       Int       @map("CountryID")
  cityId          Int       @map("CityID")
  zipCode         String    @map("ZipCode") @db.VarChar(10)
  contactPerson   String    @map("ContactPerson") @db.VarChar(200)
  emailAddress    String    @map("EmailAddress") @db.VarChar(100)
  countryDialCode String    @map("CountryDialCode") @db.VarChar(5)
  phoneNumber     String    @map("PhoneNumber") @db.VarChar(20)
  faxNumber       String?   @map("FaxNumber") @db.VarChar(20)
  isActive        Boolean?  @default(true) @map("IsActive")
  createdBy       Int?      @map("CreatedBy")
  createdDtTm     DateTime? @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  branchType BranchType @relation(fields: [branchTypeId], references: [branchTypeId], onDelete: Restrict)
  company    Company    @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  country    Country    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city       City       @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  employees  Employee[]

  @@unique([companyId, branchName], map: "Branch_Company_Name_key")
  @@index([tenantId], map: "Branch_TenantID_idx")
  @@index([tenantId, companyId], map: "Branch_TenantID_CompanyID_idx")
  @@index([companyId], map: "Branch_CompanyID_idx")
  @@index([branchTypeId], map: "Branch_BranchTypeID_idx")
  @@index([countryId], map: "Branch_CountryID_idx")
  @@index([cityId], map: "Branch_CityID_idx")
  @@map("Branch")
}

/// Department master — scoped by TenantID + CompanyID.
model Department {
  departmentId   Int       @id @default(autoincrement()) @map("DepartmentID")
  departmentCode String    @map("DepartmentCode") @db.VarChar(20)
  departmentName String    @map("DepartmentName") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  tenantId       Int       @map("TenantID")
  companyId      Int       @map("CompanyID")

  employees Employee[]

  @@unique([tenantId, companyId, departmentCode], map: "Department_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "Department_TenantID_CompanyID_idx")
  @@map("Department")
}

/// Designation master — scoped by TenantID + CompanyID.
model Designation {
  designationId   Int       @id @default(autoincrement()) @map("DesignationID")
  designationCode String    @map("DesignationCode") @db.VarChar(20)
  designationName String    @map("DesignationName") @db.VarChar(100)
  isActive        Boolean   @default(true) @map("IsActive")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  tenantId        Int       @map("TenantID")
  companyId       Int       @map("CompanyID")

  employees Employee[]

  @@unique([tenantId, companyId, designationCode], map: "Designation_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "Designation_TenantID_CompanyID_idx")
  @@map("Designation")
}

/// Employee master — HR record linked to a login User (UserID). Scoped by TenantID + CompanyID.
model Employee {
  employeeId          Int       @id @default(autoincrement()) @map("EmployeeID")
  title               String    @map("Title") @db.VarChar(10)
  firstName           String    @map("FirstName") @db.VarChar(50)
  lastName            String    @map("LastName") @db.VarChar(50)
  gender              String    @map("Gender") @db.VarChar(10)
  countryDialCode     String    @map("CountryDialCode") @db.VarChar(5)
  phoneNumber         String    @map("PhoneNumber") @db.VarChar(20)
  faxNumber           String?   @map("FaxNumber") @db.VarChar(50)
  email               String    @map("Email") @db.VarChar(50)
  address             String    @map("Address") @db.VarChar(50)
  countryId           Int       @map("CountryID")
  cityId              Int       @map("CityID")
  employeeNumber      String    @map("EmployeeNumber") @db.VarChar(50)
  designationId       Int       @map("DesignationId")
  joiningDate         DateTime  @map("JoiningDate") @db.Timestamptz(6)
  accessRoleId        Int       @map("AccessRoleID")
  departmentId        Int?      @map("DepartmentID")
  reportingEmployeeId Int?      @map("ReportingEmployeeID")
  companyId           Int       @map("CompanyID")
  branchId            Int       @map("BranchID")
  userId              Int       @unique @map("UserID")
  employeeImage       String?   @map("EmployeeImage") @db.VarChar(100)
  tenantId            Int       @map("TenantID")
  isActive            Boolean   @default(true) @map("IsActive")
  createdBy           Int       @map("CreatedBy")
  createdDtTm         DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy          Int?      @map("ModifiedBy")
  modifiedDtTm        DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country           Country     @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city              City        @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  designation       Designation @relation(fields: [designationId], references: [designationId], onDelete: Restrict)
  accessRole        AccessRole  @relation(fields: [accessRoleId], references: [accessRoleId], onDelete: Restrict)
  department        Department? @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  reportingEmployee Employee?   @relation("EmployeeReportsTo", fields: [reportingEmployeeId], references: [employeeId], onDelete: SetNull)
  directReports     Employee[]  @relation("EmployeeReportsTo")
  company           Company     @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  branch            Branch      @relation(fields: [branchId], references: [branchId], onDelete: Restrict)
  user              User        @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@unique([tenantId, companyId, employeeNumber], map: "Employee_Tenant_Company_Number_key")
  @@index([tenantId, companyId], map: "Employee_TenantID_CompanyID_idx")
  @@index([branchId], map: "Employee_BranchID_idx")
  @@index([departmentId], map: "Employee_DepartmentID_idx")
  @@index([designationId], map: "Employee_DesignationId_idx")
  @@index([accessRoleId], map: "Employee_AccessRoleID_idx")
  @@index([countryId], map: "Employee_CountryID_idx")
  @@index([cityId], map: "Employee_CityID_idx")
  @@map("Employee")
}

/// Global Subscription Product master — Super Admin / Tenant Configuration only.
model SubscriptionProduct {
  subscriptionProductId   Int       @id @default(autoincrement()) @map("SubscriptionProductID")
  subscriptionProductName String    @unique @map("SubscriptionProductName") @db.VarChar(50)
  description             String    @default("") @map("Description") @db.VarChar(200)
  isActive                Boolean   @default(true) @map("IsActive")
  createdBy               Int       @map("CreatedBy")
  createdDtTm             DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy              Int?      @map("ModifiedBy")
  modifiedDtTm            DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  modules    SubscriptionModule[]
  menuLinks  SubscriptionModuleMenuProduct[]

  @@map("SubscriptionProduct")
}

/// Global Subscription Module master — belongs to a Subscription Product.
model SubscriptionModule {
  subscriptionModuleId   Int       @id @default(autoincrement()) @map("SubscriptionModuleID")
  subscriptionProductId  Int       @map("SubscriptionProductID")
  subscriptionModuleName String    @map("SubscriptionModuleName") @db.VarChar(50)
  description            String    @default("") @map("Description") @db.VarChar(200)
  sortOrder              Int       @default(0) @map("SortOrder")
  /// When false, module is a separate portal (e.g. B2B, CBT) — not shown in Admin/Super Admin sidebar.
  showInMenu             Boolean   @default(true) @map("ShowInMenu")
  isActive               Boolean   @default(true) @map("IsActive")
  createdBy              Int       @map("CreatedBy")
  createdDtTm            DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy             Int?      @map("ModifiedBy")
  modifiedDtTm           DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  product SubscriptionProduct @relation(fields: [subscriptionProductId], references: [subscriptionProductId], onDelete: Restrict)
  access  SubscriptionModuleAccess[]
  menus   SubscriptionModuleMenu[]

  @@unique([subscriptionProductId, subscriptionModuleName], map: "SubscriptionModule_Product_Name_key")
  @@index([subscriptionProductId], map: "SubscriptionModule_ProductID_idx")
  @@map("SubscriptionModule")
}

/// Grants a Subscription Module to a Tenant — Super Admin / Tenant Configuration only.
model SubscriptionModuleAccess {
  subscriptionModuleAccessId Int       @id @default(autoincrement()) @map("SubscriptionModuleAccessID")
  subscriptionModuleId       Int       @map("SubscriptionModuleID")
  tenantId                   Int       @map("TenantID")
  isActive                   Boolean   @default(true) @map("IsActive")
  createdBy                  Int       @map("CreatedBy")
  createdDtTm                DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                 Int?      @map("ModifiedBy")
  modifiedDtTm               DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  module SubscriptionModule @relation(fields: [subscriptionModuleId], references: [subscriptionModuleId], onDelete: Restrict)
  tenant Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@unique([subscriptionModuleId, tenantId], map: "SubscriptionModuleAccess_Module_Tenant_key")
  @@index([subscriptionModuleId], map: "SubscriptionModuleAccess_ModuleID_idx")
  @@index([tenantId], map: "SubscriptionModuleAccess_TenantID_idx")
  @@map("SubscriptionModuleAccess")
}

/// Menus belonging to a Subscription Module — Tenant Admins only see menus for modules granted to their tenant.
/// Hierarchy, icons, and sort order are stored here (not hard-coded in the app).
model SubscriptionModuleMenu {
  subscriptionModuleMenuId Int       @id @default(autoincrement()) @map("SubscriptionModuleMenuID")
  subscriptionModuleId     Int       @map("SubscriptionModuleID")
  parentMenuId             Int?      @map("ParentMenuID")
  menuName                 String    @map("MenuName") @db.VarChar(100)
  menuUrl                  String    @map("MenuURL") @db.VarChar(200)
  menuIcon                 String    @default("Layers") @map("MenuIcon") @db.VarChar(50)
  sortOrder                Int       @default(0) @map("SortOrder")
  isActive                 Boolean   @default(true) @map("IsActive")
  createdBy                Int       @map("CreatedBy")
  createdDtTm              DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy               Int?      @map("ModifiedBy")
  modifiedDtTm             DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  module   SubscriptionModule       @relation(fields: [subscriptionModuleId], references: [subscriptionModuleId], onDelete: Restrict)
  parent   SubscriptionModuleMenu?  @relation("MenuHierarchy", fields: [parentMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)
  children SubscriptionModuleMenu[] @relation("MenuHierarchy")
  /// Products that unlock this menu when it belongs to the shared Administration module.
  productLinks SubscriptionModuleMenuProduct[]
  roleMenuPermissions TenantAccessRoleMenuPermission[]

  @@unique([subscriptionModuleId, menuUrl], map: "SubscriptionModuleMenu_Module_URL_key")
  @@index([subscriptionModuleId], map: "SubscriptionModuleMenu_ModuleID_idx")
  @@index([parentMenuId], map: "SubscriptionModuleMenu_ParentMenuID_idx")
  @@map("SubscriptionModuleMenu")
}

/// Per Access Role CRUD flags for each Subscription Module Menu (tenant/company scoped).
model TenantAccessRoleMenuPermission {
  tenantAccessRoleMenuPermissionId Int       @id @default(autoincrement()) @map("TenantAccessRoleMenuPermissionID")
  tenantId                         Int       @map("TenantID")
  companyId                        Int       @map("CompanyID")
  accessRoleId                     Int       @map("AccessRoleID")
  subscriptionModuleMenuId         Int       @map("SubscriptionModuleMenuID")
  canView                          Boolean   @default(false) @map("CanView")
  canCreate                        Boolean   @default(false) @map("CanCreate")
  canEdit                          Boolean   @default(false) @map("CanEdit")
  canDelete                        Boolean   @default(false) @map("CanDelete")
  canApprove                       Boolean   @default(false) @map("CanApprove")
  canExport                        Boolean   @default(false) @map("CanExport")
  canPrint                         Boolean   @default(false) @map("CanPrint")
  canReadOnly                      Boolean   @default(false) @map("CanReadOnly")
  isActive                         Boolean   @default(true) @map("IsActive")
  createdBy                        Int       @map("CreatedBy")
  createdDtTm                      DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                       Int?      @map("ModifiedBy")
  modifiedDtTm                     DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  accessRole AccessRole             @relation(fields: [accessRoleId], references: [accessRoleId], onDelete: Cascade)
  menu       SubscriptionModuleMenu @relation(fields: [subscriptionModuleMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)

  @@unique([tenantId, companyId, accessRoleId, subscriptionModuleMenuId], map: "TARMP_Tenant_Company_Role_Menu_key")
  @@index([tenantId, companyId, accessRoleId], map: "TARMP_Tenant_Company_Role_idx")
  @@index([subscriptionModuleMenuId], map: "TARMP_MenuID_idx")
  @@map("TenantAccessRoleMenuPermission")
}

/// Links an Administration menu to Subscription Products that unlock it for a tenant
/// (tenant sees the menu if they have Module Access to any module under a linked product).
/// Empty links = common admin menu (visible whenever Administration is shown).
model SubscriptionModuleMenuProduct {
  subscriptionModuleMenuProductId Int       @id @default(autoincrement()) @map("SubscriptionModuleMenuProductID")
  subscriptionModuleMenuId        Int       @map("SubscriptionModuleMenuID")
  subscriptionProductId           Int       @map("SubscriptionProductID")
  createdBy                       Int       @map("CreatedBy")
  createdDtTm                     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                      Int?      @map("ModifiedBy")
  modifiedDtTm                    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  menu    SubscriptionModuleMenu @relation(fields: [subscriptionModuleMenuId], references: [subscriptionModuleMenuId], onDelete: Cascade)
  product SubscriptionProduct    @relation(fields: [subscriptionProductId], references: [subscriptionProductId], onDelete: Restrict)

  @@unique([subscriptionModuleMenuId, subscriptionProductId], map: "SubscriptionModuleMenuProduct_Menu_Product_key")
  @@index([subscriptionModuleMenuId], map: "SubscriptionModuleMenuProduct_MenuID_idx")
  @@index([subscriptionProductId], map: "SubscriptionModuleMenuProduct_ProductID_idx")
  @@map("SubscriptionModuleMenuProduct")
}
