  propertyContractPromotionConditionId BigInt    @id @default(autoincrement()) @map("PropertyContractPromotionConditionID")
  tenantId                             Int       @map("TenantID")
  companyId                            Int       @map("CompanyID")
  propertyContractPromotionId          BigInt    @map("PropertyContractPromotionID")
  minNights                            Int?      @map("MinNights")
  maxNights                            Int?      @map("MaxNights")
  minAdults                            Int?      @map("MinAdults")
  maxAdults                            Int?      @map("MaxAdults")
  minChild                             Int?      @map("MinChild")
  maxChild                             Int?      @map("MaxChild")
  minRooms                             Int?      @map("MinRooms")
  maxRooms                             Int?      @map("MaxRooms")
  isActive                             Boolean   @default(true) @map("IsActive")
  createdBy                            Int       @map("CreatedBy")
  createdDtTm                          DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                           Int?      @map("ModifiedBy")
  modifiedDtTm                         DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  promotion PropertyContractPromotion @relation(fields: [propertyContractPromotionId], references: [propertyContractPromotionId], onDelete: Cascade)

  @@index([tenantId, companyId], map: "PropertyContractPromotionCondition_TenantID_CompanyID_idx")
  @@index([propertyContractPromotionId], map: "PropertyContractPromotionCondition_PromotionID_idx")
  @@map("PropertyContractPromotionCondition")
}

/// Benefit granted by a contract promotion.
model PropertyContractPromotionBenefit {
  propertyContractPromotionBenefitId BigInt    @id @default(autoincrement()) @map("PropertyContractPromotionBenefitID")
  tenantId                           Int       @map("TenantID")
  companyId                          Int       @map("CompanyID")
  propertyContractPromotionId        BigInt    @map("PropertyContractPromotionID")
  promotionBenefitTypeId             BigInt    @map("PromotionBenefitTypeID")
  value                              Decimal?  @map("Value") @db.Decimal(18, 4)
  stayNights                         Int?      @map("StayNights")
  payNights                          Int?      @map("PayNights")
  freeNights                         Int?      @map("FreeNights")
  upgradeToPropertyRoomId            BigInt?   @map("UpgradeToPropertyRoomTypeID")
  /// Meal / board basis upgrade (domain BoardBasisID → MealPlan master).
  upgradeToMealPlanId                BigInt?   @map("UpgradeToBoardBasisID")
  isActive                           Boolean   @default(true) @map("IsActive")
  createdBy                          Int       @map("CreatedBy")
  createdDtTm                        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                         Int?      @map("ModifiedBy")
  modifiedDtTm                       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  promotion        PropertyContractPromotion @relation(fields: [propertyContractPromotionId], references: [propertyContractPromotionId], onDelete: Cascade)
  benefitType      PromotionBenefitType      @relation(fields: [promotionBenefitTypeId], references: [promotionBenefitTypeId], onDelete: Restrict)
  upgradeRoom      PropertyRoom?             @relation("PromotionUpgradeRoom", fields: [upgradeToPropertyRoomId], references: [propertyRoomId], onDelete: Restrict)
  upgradeMealPlan  MealPlan?                 @relation(fields: [upgradeToMealPlanId], references: [mealPlanId], onDelete: Restrict)

  @@index([tenantId, companyId], map: "PropertyContractPromotionBenefit_TenantID_CompanyID_idx")
  @@index([propertyContractPromotionId], map: "PropertyContractPromotionBenefit_PromotionID_idx")
  @@index([promotionBenefitTypeId], map: "PropertyContractPromotionBenefit_BenefitTypeID_idx")
  @@map("PropertyContractPromotionBenefit")
}

/// Applicable days of week for a contract promotion.
model PropertyContractPromotionDay {
  propertyContractPromotionDayId BigInt    @id @default(autoincrement()) @map("PropertyContractPromotionDayID")
  tenantId                       Int       @map("TenantID")
  companyId                      Int       @map("CompanyID")
