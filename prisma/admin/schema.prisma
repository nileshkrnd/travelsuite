  createdBy       Int       @map("CreatedBy")
  updatedDate     DateTime? @map("UpdatedDate") @db.Timestamptz(6)
  updatedBy       Int?      @map("UpdatedBy")

  supplier   Supplier   @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  accessRole AccessRole @relation(fields: [accessRoleId], references: [accessRoleId], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [userId], onDelete: Restrict)

  contractContacts PropertyContract[]

  @@unique([supplierId, email], map: "SupplierUser_Supplier_Email_key")
  @@index([accessRoleId], map: "SupplierUser_AccessRoleID_idx")
  @@map("SupplierUser")
}

/// Grants a Supplier's portal user rate-management access to one Property↔Supplier link.
model SupplierPropertyAccess {
  supplierPropertyAccessId BigInt    @id @default(autoincrement()) @map("SupplierPropertyAccessID")
