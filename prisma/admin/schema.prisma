  availability  PropertyRoomAvailability[]
  contractInventories PropertyContractInventory[]
  contractSupplements PropertyContractSupplement[]
  contractChildPolicies PropertyContractChildPolicy[]
  contractCancellationPolicies PropertyContractCancellationPolicy[]
  contractPromotions           PropertyContractPromotion[]
