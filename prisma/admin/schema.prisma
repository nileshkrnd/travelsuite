/// Property master — scoped by TenantID + CompanyID.
/// Global property master. TenantID/CompanyID = NULL means a globally-managed property (Super Admin owned, e.g. a major hotel chain); a real TenantID/CompanyID means a property a tenant registered for itself.
model Property {
  propertyId          Int       @id @default(autoincrement()) @map("PropertyID")
  tenantId            Int?      @map("TenantID")
  companyId           Int?      @map("CompanyID")
  propertyCode        String    @map("PropertyCode") @db.VarChar(50)
  propertyName        String?   @map("PropertyName") @db.VarChar(250)
  propertyDisplayName String?   @map("PropertyDisplayName") @db.VarChar(250)
  shortDescription    String?   @map("ShortDescription") @db.Text
  description         String?   @map("Description") @db.Text
  internalRemarks     String?   @map("InternalRemarks") @db.Text
  propertyUsageId     BigInt?   @map("PropertyUsageID")
  ownershipTypeId     BigInt?   @map("OwnershipTypeID")
  propertyBrandId     BigInt?   @map("PropertyBrandID")
  /// Optional supplier reference (no DB FK yet — supplier master is still app-store based).
  supplierId          Int?      @map("SupplierID")
  addressLine1        String?   @map("AddressLine1") @db.VarChar(255)
  addressLine2        String?   @map("AddressLine2") @db.VarChar(255)
  buildingName        String?   @map("BuildingName") @db.VarChar(150)
  buildingNumber      String?   @map("BuildingNumber") @db.VarChar(50)
  streetName          String?   @map("StreetName") @db.VarChar(150)
  streetNumber        String?   @map("StreetNumber") @db.VarChar(20)
  zoneNumber          String?   @map("ZoneNumber") @db.VarChar(20)
  countryId           Int       @map("CountryID")
  /// Optional until State master is wired (no DB FK yet).
  stateId             Int?      @map("StateID")
  cityId              Int?      @map("CityID")
  /// Optional until Area master is wired (no DB FK yet).
  areaId              Int?      @map("AreaID")
  /// Optional until Location master is wired (no DB FK yet).
  locationId          Int?      @map("LocationID")
  postalCode          String?   @map("PostalCode") @db.VarChar(20)
  poBox               String?   @map("POBox") @db.VarChar(50)
  landmark            String?   @map("Landmark") @db.VarChar(255)
  latitude            Decimal?  @map("Latitude") @db.Decimal(9, 6)
  longitude           Decimal?  @map("Longitude") @db.Decimal(9, 6)
  googlePlaceId       String?   @map("GooglePlaceID") @db.VarChar(255)
  googleMapUrl        String?   @map("GoogleMapURL") @db.Text
  plusCode            String?   @map("PlusCode") @db.VarChar(50)
  /// Optional until TimeZone master is wired (no DB FK yet).
  timeZoneId          Int?      @map("TimeZoneID")
  openingDate         DateTime? @map("OpeningDate") @db.Date
  closingDate         DateTime? @map("ClosingDate") @db.Date
  rating              Decimal?  @map("Rating") @db.Decimal(3, 2)
  starRating          Int?      @map("StarRating") @db.SmallInt
  isFeatured          Boolean   @default(false) @map("IsFeatured")
  isPublished         Boolean   @default(false) @map("IsPublished")
  isActive            Boolean   @default(true) @map("IsActive")
  createdBy           Int?      @map("CreatedBy")
  createdDtTm         DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy          Int?      @map("ModifiedBy")
  modifiedDtTm        DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  typeLinks        PropertyTypeLink[]
  categoryLinks    PropertyCategoryLink[]
  propertyUsage    PropertyUsage?             @relation(fields: [propertyUsageId], references: [propertyUsageId], onDelete: SetNull)
  ownershipType    OwnershipType?             @relation(fields: [ownershipTypeId], references: [ownershipTypeId], onDelete: SetNull)
  propertyBrand    PropertyBrand?             @relation(fields: [propertyBrandId], references: [propertyBrandId], onDelete: SetNull)
  country          Country                    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city             City?                      @relation(fields: [cityId], references: [cityId], onDelete: SetNull)
  media            PropertyMedia[]
  amenityLinks     PropertyAmenity[]
  facilityLinks    PropertyFacility[]
  supplierLinks    PropertySupplier[]
  employeeAccess   EmployeePropertyAccess[]
  contracts        PropertyContract[]
  seasons          PropertySeason[]
  rooms            PropertyRoom[]
  roomTypeMedia    PropertyRoomTypeMedia[]
  roomAvailability PropertyRoomAvailability[]
  setupNotes       PropertySetupNote[]

  @@unique([tenantId, companyId, propertyCode], map: "Property_Tenant_Company_Code_key")
  @@index([tenantId, companyId], map: "Property_TenantID_CompanyID_idx")
  @@index([propertyUsageId], map: "Property_PropertyUsageID_idx")
  @@index([ownershipTypeId], map: "Property_OwnershipTypeID_idx")
  @@index([propertyBrandId], map: "Property_PropertyBrandID_idx")
  @@index([countryId], map: "Property_CountryID_idx")
  @@index([cityId], map: "Property_CityID_idx")
  @@index([createdDtTm], map: "Property_CreatedDtTm_idx")
  @@map("Property")
}

/// Operational note on a property's commercial-readiness setup (Extranet "Select Property" go-live dashboard).
model PropertySetupNote {
  propertySetupNoteId BigInt   @id @default(autoincrement()) @map("PropertySetupNoteID")
  tenantId            Int      @map("TenantID")
  companyId           Int      @map("CompanyID")
  propertyId          Int      @map("PropertyID")
  /// Optional readiness step this note relates to (e.g. "contractRates"); null = general note.
  stepCode            String?  @map("StepCode") @db.VarChar(50)
  note                String   @map("Note") @db.Text
  priority            String   @default("normal") @map("Priority") @db.VarChar(20)
  createdBy           Int      @map("CreatedBy")
  createdDtTm         DateTime @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@index([tenantId, companyId, propertyId], map: "PropertySetupNote_Tenant_Company_Property_idx")
  @@map("PropertySetupNote")
}

/// Property media (photos/videos), attached to a Property. One row per property may be marked the cover image (enforced by a partial unique index in the migration).
model PropertyMedia {
  propertyMediaId BigInt    @id @default(autoincrement()) @map("PropertyMediaID")
  propertyId      Int       @map("PropertyID")
  /// image | video
  mediaType       String    @map("MediaType") @db.VarChar(20)
  /// Rooms | Bathroom | Amenities | Pool | Common Areas | Dining | Others
  imageType       String    @map("ImageType") @db.VarChar(50)
  mediaUrl        String    @map("MediaUrl") @db.VarChar(500)
  fileName        String?   @map("FileName") @db.VarChar(255)
  description     String?   @map("Description") @db.Text
  isCover         Boolean   @default(false) @map("IsCover")
  displayOrder    Int       @default(0) @map("DisplayOrder")
  isActive        Boolean   @default(true) @map("IsActive")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted       Boolean   @default(false) @map("IsDeleted")

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@index([propertyId], map: "PropertyMedia_PropertyID_idx")
  @@map("PropertyMediaMaster")
}

/// Many-to-many: Property ↔ PropertyType.
model PropertyTypeLink {
  propertyId     Int    @map("PropertyID")
  propertyTypeId BigInt @map("PropertyTypeID")

  property     Property     @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Restrict)

  @@id([propertyId, propertyTypeId], map: "PropertyTypeLink_pkey")
  @@index([propertyTypeId], map: "PropertyTypeLink_PropertyTypeID_idx")
  @@map("PropertyTypeLink")
}

/// Many-to-many: Property ↔ PropertyCategory.
model PropertyCategoryLink {
  propertyId         Int    @map("PropertyID")
  propertyCategoryId BigInt @map("PropertyCategoryID")

  property         Property         @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  propertyCategory PropertyCategory @relation(fields: [propertyCategoryId], references: [propertyCategoryId], onDelete: Restrict)

  @@id([propertyId, propertyCategoryId], map: "PropertyCategoryLink_pkey")
  @@index([propertyCategoryId], map: "PropertyCategoryLink_PropertyCategoryID_idx")
  @@map("PropertyCategoryLink")
}

/// Many-to-many: Property ↔ Amenity — which amenities (from the Amenity master) this property offers.
model PropertyAmenity {
  propertyId Int    @map("PropertyID")
  amenityId  BigInt @map("AmenityID")

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [amenityId], onDelete: Cascade)

  @@id([propertyId, amenityId], map: "PropertyAmenityLink_pkey")
  @@index([amenityId], map: "PropertyAmenityLink_AmenityID_idx")
  @@map("PropertyAmenityLink")
}

/// Many-to-many: Property ↔ Facility — which facilities (from the Facility master) this property offers.
model PropertyFacility {
  propertyId Int    @map("PropertyID")
  facilityId BigInt @map("FacilityID")

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [facilityId], onDelete: Cascade)

  @@id([propertyId, facilityId], map: "PropertyFacilityLink_pkey")
  @@index([facilityId], map: "PropertyFacilityLink_FacilityID_idx")
  @@map("PropertyFacilityLink")
}

/// Branch Type master — Super Admin / Tenant Configuration only (e.g. Head Office, Branch Office).
/// Branch type master — scoped by TenantID + CompanyID.
model BranchType {
  branchTypeId   Int       @id @default(autoincrement()) @map("BranchTypeID")
