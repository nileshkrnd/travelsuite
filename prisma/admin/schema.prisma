  user             User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([propertySupplierId, userId], map: "SupplierPropertyAccess_PropertySupplier_User_key")
  @@index([userId], map: "SupplierPropertyAccess_UserID_idx")
  @@index([tenantId, companyId], map: "SupplierPropertyAccess_TenantID_CompanyID_idx")
