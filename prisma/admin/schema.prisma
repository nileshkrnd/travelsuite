  fromDate                     DateTime? @map("FromDate") @db.Date
  toDate                       DateTime? @map("ToDate") @db.Date
  isActive                     Boolean   @default(true) @map("IsActive")
  createdBy                    Int       @map("CreatedBy")
  createdDtTm                  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy                   Int?      @map("ModifiedBy")
  modifiedDtTm                 DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  propertyContract PropertyContract @relation(fields: [propertyContractId], references: [propertyContractId], onDelete: Cascade)
  marketType       MarketType       @relation(fields: [marketTypeId], references: [marketTypeId], onDelete: Restrict)
  region           Region?          @relation(fields: [regionId], references: [regionId], onDelete: Restrict)
  country          Country?         @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city             City?            @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  marketGroup      MarketGroup?     @relation(fields: [marketGroupId], references: [marketGroupId], onDelete: Restrict)

  @@index([tenantId, companyId], map: "PropertyContractMarketRule_TenantID_CompanyID_idx")
