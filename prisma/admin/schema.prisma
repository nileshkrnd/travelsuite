  propertyContractId             BigInt    @map("PropertyContractID")
  propertyContractSeasonPeriodId BigInt    @map("PropertyContractSeasonPeriodID")
  /// Property room type (PropertyRoom master — domain PropertyRoomTypeID).
  propertyRoomId                 BigInt    @map("PropertyRoomTypeID")
  inventoryTypeId                BigInt    @map("InventoryTypeID")
  allotmentQty                   Int       @default(0) @map("AllotmentQty")
