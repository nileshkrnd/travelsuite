/// KlyraAdmin — masters & configuration (Tenant, User, Company, geo, aviation, …).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMINCNX_URL")
}

/// Tenant master — primary org entry point (holding / legal entity).
model Tenant {
  tenantId            Int       @id @default(autoincrement()) @map("TenantID")
  /// Stable app string id (e.g. tenant_regency) used by mock/company FKs until those move to DB.
  tenantUid           String    @unique @map("TenantUid") @db.VarChar(100)
  tenantCode          String    @unique @map("TenantCode") @db.VarChar(100)
  tenantName          String    @map("TenantName") @db.VarChar(200)
  groupName           String    @map("GroupName") @db.VarChar(200)
  defaultCurrency     String    @map("DefaultCurrency") @db.VarChar(10)
  supportedCurrencies String    @map("SupportedCurrencies") @db.VarChar(200)
  defaultLocale       String    @default("en") @map("DefaultLocale") @db.VarChar(10)
  supportedLocales    String    @default("en") @map("SupportedLocales") @db.VarChar(100)
  primaryColor        String    @map("PrimaryColor") @db.VarChar(20)
  logoUrl             String    @default("") @map("LogoUrl") @db.VarChar(500)
  addressLine1        String    @map("AddressLine1") @db.VarChar(200)
  addressLine2        String?   @map("AddressLine2") @db.VarChar(200)
  country             String    @map("Country") @db.VarChar(10)
  city                String    @map("City") @db.VarChar(100)
  zip                 String    @map("Zip") @db.VarChar(30)
  timezone            String    @map("Timezone") @db.VarChar(100)
  email               String    @map("Email") @db.VarChar(200)
  dialCode            String    @map("DialCode") @db.VarChar(20)
  phone               String    @map("Phone") @db.VarChar(50)
  status              String    @default("active") @map("Status") @db.VarChar(20)
  createdBy           Int       @map("CreatedBy")
  createdDtTm         DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy          Int?      @map("ModifiedBy")
  modifiedDtTm        DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  moduleAccess   SubscriptionModuleAccess[]
  tenantCultures TenantCulture[]

  @@map("Tenant")
}

/// Global Culture master — languages/locales assignable to tenants (en, ar, es, …).
model Culture {
  cultureId    Int       @id @default(autoincrement()) @map("CultureID")
  cultureCode  String    @unique @map("CultureCode") @db.VarChar(10)
  cultureName  String    @map("CultureName") @db.VarChar(200)
  /// Text direction: "ltr" | "rtl"
  direction    String    @default("ltr") @map("Direction") @db.VarChar(10)
  isActive     Boolean   @default(true) @map("IsActive")
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  tenantCultures TenantCulture[]

  @@map("Culture")
}

/// Cultures enabled for a tenant — one row marked IsDefault.
model TenantCulture {
  tenantCultureId Int       @id @default(autoincrement()) @map("TenantCultureID")
  tenantId        Int       @map("TenantID")
  cultureId       Int       @map("CultureID")
  isDefault       Boolean   @default(false) @map("IsDefault")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  culture Culture @relation(fields: [cultureId], references: [cultureId], onDelete: Restrict)

  @@unique([tenantId, cultureId], map: "TenantCulture_Tenant_Culture_key")
  @@index([tenantId], map: "TenantCulture_TenantID_idx")
  @@index([cultureId], map: "TenantCulture_CultureID_idx")
  @@map("TenantCulture")
}

/// Global Country master — not scoped to Tenant or Company.
model Country {
  countryId    Int       @id @default(autoincrement()) @map("CountryID")
  countryCode  String    @unique @map("CountryCode") @db.VarChar(10)
  countryName  String    @map("CountryName") @db.VarChar(200)
  dialCode     String    @map("DialCode") @db.VarChar(20)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  cities     City[]
  states     State[]
  areas      Area[]
  locations  Location[]
  airports   Airport[]
  companies  Company[]
  branches   Branch[]
  employees  Employee[]
  properties Property[]
  suppliers  Supplier[]

  @@map("Country")
}

/// Global City master — belongs to Country only (no Tenant / Company).
model City {
  cityId       Int       @id @default(autoincrement()) @map("CityID")
  countryId    Int       @map("CountryID")
  cityCode     String    @map("CityCode") @db.VarChar(100)
  cityName     String    @map("CityName") @db.VarChar(200)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country         Country    @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  airports        Airport[]
  companies       Company[]
  branches        Branch[]
  employees       Employee[]
  properties      Property[]
  capitalOfStates State[]    @relation("StateCapitalCity")
  areas           Area[]
  locations       Location[]
  suppliers       Supplier[]

  @@unique([countryId, cityCode], map: "City_Country_Code_key")
  @@index([countryId], map: "City_CountryID_idx")
  @@map("City")
}

/// State/Province administrative type lookup (State, Province, Emirate, Governorate, Region). Global.
model StateAdministrativeType {
  stateAdministrativeTypeId Int       @id @default(autoincrement()) @map("StateAdministrativeTypeID")
  administrativeType        String    @unique @map("AdministrativeType") @db.VarChar(150)
  isActive                  Boolean   @default(true) @map("IsActive")
  createdBy                 Int       @map("CreatedBy")
  createdDtTm               DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy                Int?      @map("ModifiedBy")
  modifiedDtTm              DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted                 Boolean   @default(false) @map("IsDeleted")

  states State[]

  @@map("StateAdministrativeType")
}

/// Global State/Province master — belongs to a Country only (no Tenant / Company).
model State {
  stateId                   Int       @id @default(autoincrement()) @map("StateID")
  countryId                 Int       @map("CountryID")
  stateCode                 String    @map("StateCode") @db.VarChar(20)
  isoCode                   String?   @unique @map("ISOCode") @db.VarChar(20)
  stateName                 String    @map("StateName") @db.VarChar(150)
  nativeName                String?   @map("NativeName") @db.VarChar(150)
  stateAdministrativeTypeId Int?      @map("StateAdministrativeTypeID")
  capitalCityId             Int?      @map("CapitalCityID")
  latitude                  Decimal?  @map("Latitude") @db.Decimal(9, 6)
  longitude                 Decimal?  @map("Longitude") @db.Decimal(9, 6)
  displayOrder              Int       @default(0) @map("DisplayOrder")
  isActive                  Boolean   @default(true) @map("IsActive")
  createdBy                 Int       @map("CreatedBy")
  createdDtTm               DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy                Int?      @map("ModifiedBy")
  modifiedDtTm              DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted                 Boolean   @default(false) @map("IsDeleted")

  country            Country                  @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  administrativeType StateAdministrativeType? @relation(fields: [stateAdministrativeTypeId], references: [stateAdministrativeTypeId], onDelete: SetNull)
  capitalCity        City?                    @relation("StateCapitalCity", fields: [capitalCityId], references: [cityId], onDelete: SetNull)
  locations          Location[]
  suppliers          Supplier[]

  @@unique([countryId, stateCode], map: "State_Country_Code_key")
  @@index([countryId], map: "State_CountryID_idx")
  @@map("State")
}

/// Area type lookup (Residential, Commercial, Industrial, …) — also used to categorize nearby points of interest (Airport, Mall, Beach, …). Global.
model AreaType {
  areaTypeId   Int       @id @default(autoincrement()) @map("AreaTypeID")
  areaTypeCode String    @unique @map("AreaTypeCode") @db.VarChar(50)
  areaTypeName String    @unique @map("AreaTypeName") @db.VarChar(150)
  isActive     Boolean   @default(true) @map("IsActive")
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted    Boolean   @default(false) @map("IsDeleted")

  areas Area[]

  @@map("AreaType")
}

/// Global Area/Locality master — belongs to a City within a Country.
model Area {
  areaId        Int       @id @default(autoincrement()) @map("AreaID")
  countryId     Int       @map("CountryID")
  cityId        Int       @map("CityID")
  areaCode      String    @map("AreaCode") @db.VarChar(30)
  areaName      String    @map("AreaName") @db.VarChar(150)
  nativeName    String?   @map("NativeName") @db.VarChar(150)
  areaTypeId    Int?      @map("AreaTypeID")
  latitude      Decimal?  @map("Latitude") @db.Decimal(9, 6)
  longitude     Decimal?  @map("Longitude") @db.Decimal(9, 6)
  googlePlaceId String?   @map("GooglePlaceID") @db.VarChar(255)
  displayOrder  Int       @default(0) @map("DisplayOrder")
  isPopular     Boolean   @default(false) @map("IsPopular")
  isActive      Boolean   @default(true) @map("IsActive")
  createdBy     Int       @map("CreatedBy")
  createdDtTm   DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy    Int?      @map("ModifiedBy")
  modifiedDtTm  DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted     Boolean   @default(false) @map("IsDeleted")

  country  Country   @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city     City      @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  areaType AreaType? @relation(fields: [areaTypeId], references: [areaTypeId], onDelete: SetNull)

  locations Location[]

  @@unique([cityId, areaCode], map: "Area_City_Code_key")
  @@index([countryId], map: "Area_CountryID_idx")
  @@index([cityId], map: "Area_CityID_idx")
  @@map("Area")
}

/// Location type lookup (Neighborhood, Street, District, …). Global.
model LocationType {
  locationTypeId   Int       @id @default(autoincrement()) @map("LocationTypeID")
  locationTypeName String    @unique @map("LocationTypeName") @db.VarChar(150)
  isActive         Boolean   @default(true) @map("IsActive")
  createdBy        Int       @map("CreatedBy")
  createdDtTm      DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy       Int?      @map("ModifiedBy")
  modifiedDtTm     DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted        Boolean   @default(false) @map("IsDeleted")

  locations Location[]

  @@map("LocationType")
}

/// Global Location master — a subdivision of an Area (belongs to Country / optional State / City / Area).
model Location {
  locationId     Int       @id @default(autoincrement()) @map("LocationID")
  countryId      Int       @map("CountryID")
  stateId        Int?      @map("StateID")
  cityId         Int       @map("CityID")
  areaId         Int       @map("AreaID")
  locationCode   String    @map("LocationCode") @db.VarChar(30)
  locationName   String    @map("LocationName") @db.VarChar(150)
  nativeName     String?   @map("NativeName") @db.VarChar(150)
  locationTypeId Int?      @map("LocationTypeID")
  zoneNumber     String?   @map("ZoneNumber") @db.VarChar(20)
  latitude       Decimal?  @map("Latitude") @db.Decimal(9, 6)
  longitude      Decimal?  @map("Longitude") @db.Decimal(9, 6)
  googlePlaceId  String?   @map("GooglePlaceID") @db.VarChar(255)
  displayOrder   Int       @default(0) @map("DisplayOrder")
  isPopular      Boolean   @default(false) @map("IsPopular")
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted      Boolean   @default(false) @map("IsDeleted")

  country      Country       @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  state        State?        @relation(fields: [stateId], references: [stateId], onDelete: SetNull)
  city         City          @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  area         Area          @relation(fields: [areaId], references: [areaId], onDelete: Restrict)
  locationType LocationType? @relation(fields: [locationTypeId], references: [locationTypeId], onDelete: SetNull)

  @@unique([areaId, locationCode], map: "Location_Area_Code_key")
  @@index([countryId], map: "Location_CountryID_idx")
  @@index([stateId], map: "Location_StateID_idx")
  @@index([cityId], map: "Location_CityID_idx")
  @@index([areaId], map: "Location_AreaID_idx")
  @@map("Location")
}

/// Global Currency master — not scoped to Tenant or Company.
model Currency {
  currencyId        Int       @id @default(autoincrement()) @map("CurrencyID")
  currencyCode      String    @unique @map("CurrencyCode") @db.VarChar(10)
  currencyName      String    @map("CurrencyName") @db.VarChar(200)
  symbol            String    @default("") @map("Symbol") @db.VarChar(20)
  smallCurrencyName String    @map("SmallCurrencyName") @db.VarChar(100)
  significantDigit  Int       @default(2) @map("SignificantDigit")
  status            String    @default("active") @map("Status") @db.VarChar(20)
  createdBy         Int       @map("CreatedBy")
  createdDtTm       DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy        Int?      @map("ModifiedBy")
  modifiedDtTm      DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  companies         Company[]
  suppliers         Supplier[]
  propertyContracts PropertyContract[]

  @@map("Currency")
}

/// Global Region master — not scoped to Tenant or Company.
model Region {
  regionId     Int       @id @default(autoincrement()) @map("RegionID")
  regionCode   String    @unique @map("RegionCode") @db.VarChar(100)
  regionName   String    @map("RegionName") @db.VarChar(200)
  status       String    @default("active") @map("Status") @db.VarChar(20)
  createdBy    Int       @map("CreatedBy")
  createdDtTm  DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy   Int?      @map("ModifiedBy")
  modifiedDtTm DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  @@map("Region")
}

/// User master — UserTypeID enum:
/// 1 SuperAdmin, 2 TenantAdmin, 3 InternalEmployee, 4 AgencyUser,
/// 5 SubAgencyUser, 6 CorporateUser, 7 CashCustomer, 8 SupplierUser.
/// TenantID / CompanyID still scope the workspace.
model User {
  userId                 Int       @id @default(autoincrement()) @map("UserID")
  username               String    @unique @map("Username") @db.VarChar(200)
  passwordHash           String    @map("PasswordHash") @db.VarChar(500)
  userDisplayName        String    @map("UserDisplayName") @db.VarChar(200)
  /// Enum: 1=SuperAdmin … 8=SupplierUser (see types/user-type.ts).
  userTypeId             Int       @default(3) @map("UserTypeID")
  tenantId               Int       @default(0) @map("TenantID")
  companyId              Int       @default(0) @map("CompanyID")
  lastLoggedInDtTm       DateTime? @map("LastLoggedInDtTm") @db.Timestamptz(6)
  lastPasswordChangeDtTm DateTime? @map("LastPasswordChangeDtTm") @db.Timestamptz(6)
  createdBy              Int       @map("CreatedBy")
  createDtTm             DateTime  @default(now()) @map("CreateDtTm") @db.Timestamptz(6)
  modifiedBy             Int?      @map("ModifiedBy")
  modifiedDtTm           DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  isActive               Boolean   @default(true) @map("IsActive")

  employee               Employee?
  supplierUser           SupplierUser?
  supplierPropertyAccess SupplierPropertyAccess[]

  @@index([tenantId, companyId], map: "User_TenantID_CompanyID_idx")
  @@index([userTypeId], map: "User_UserTypeID_idx")
  @@map("User")
}

/// Access Role master — scoped by TenantID / CompanyID (same rules as User).
/// Platform Super Admin manages T0C0 roles; tenants manage roles under their TenantID.
model AccessRole {
  accessRoleId   Int       @id @default(autoincrement()) @map("AccessRoleID")
  accessRoleName String    @map("AccessRoleName") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  tenantId       Int       @map("TenantID")
  companyId      Int       @map("CompanyID")

  employees       Employee[]
  menuPermissions TenantAccessRoleMenuPermission[]
  supplierUsers   SupplierUser[]

  @@unique([tenantId, companyId, accessRoleName], map: "AccessRole_Tenant_Company_Name_key")
  @@index([tenantId, companyId], map: "AccessRole_TenantID_CompanyID_idx")
  @@map("AccessRole")
}

/// Global Airline Type master — Super Admin / Tenant Configuration only.
model AirlineType {
  airlineTypeId   Int       @id @default(autoincrement()) @map("AirlineTypeID")
  airlineTypeName String    @unique @map("AirlineTypeName") @db.VarChar(100)
  isActive        Boolean   @default(true) @map("IsActive")
  createdBy       Int       @map("CreatedBy")
  createdDtTm     DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  airlines Airline[]

  @@map("AirlineType")
}

/// Global Airline master — Super Admin / Tenant Configuration only.
model Airline {
  airlineId          Int       @id @default(autoincrement()) @map("AirlineID")
  airlineTypeId      Int       @map("AirlineTypeID")
  airlineCode        String    @unique @map("AirlineCode") @db.VarChar(3)
  airlineName        String    @map("AirlineName") @db.VarChar(200)
  airlineNumericCode Int?      @map("AirlineNumericCode")
  isActive           Boolean   @default(true) @map("IsActive")
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy         Int?      @map("ModifiedBy")
  modifiedDtTm       DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)
  pnrMaxDigit        Int       @map("PNRMaxDigit")
  tktMaxDigit        Int       @map("TKTMaxDigit")
  isTktNumberOnly    Boolean   @default(false) @map("IsTKTNumberOnly")

  airlineType AirlineType @relation(fields: [airlineTypeId], references: [airlineTypeId], onDelete: Restrict)

  @@index([airlineTypeId], map: "Airline_AirlineTypeID_idx")
  @@map("Airline")
}

/// Global Airport master — Super Admin / Tenant Configuration only.
/// ParentAirportID = 0 means no parent airport.
model Airport {
  airportId       Int       @id @default(autoincrement()) @map("AirportID")
  airportCode     String    @unique @map("AirportCode") @db.VarChar(3)
  airportName     String    @map("AirportName") @db.VarChar(300)
  countryId       Int       @map("CountryID")
  cityId          Int       @map("CityID")
  parentAirportId Int       @default(0) @map("ParentAirportID")
  latitude        String?   @map("Latitude") @db.VarChar(20)
  longitude       String?   @map("Longitude") @db.VarChar(20)
  isActive        Boolean?  @default(true) @map("IsActive")
  createdBy       Int?      @map("CreatedBy")
  createdDtTm     DateTime? @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy      Int?      @map("ModifiedBy")
  modifiedDtTm    DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  country Country @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  city    City    @relation(fields: [cityId], references: [cityId], onDelete: Restrict)

  @@index([countryId], map: "Airport_CountryID_idx")
  @@index([cityId], map: "Airport_CityID_idx")
  @@map("Airport")
}

/// Supplier Type lookup (DMC, Hotelier, Tour Operator, Transport, Activity Provider, …). Global.
model SupplierType {
  supplierTypeId   BigInt    @id @default(autoincrement()) @map("SupplierTypeID")
  supplierTypeName String    @unique @map("SupplierTypeName") @db.VarChar(150)
  isActive         Boolean   @default(true) @map("IsActive")
  createdBy        Int       @map("CreatedBy")
  createdDtTm      DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy       Int?      @map("ModifiedBy")
  modifiedDtTm     DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted        Boolean   @default(false) @map("IsDeleted")

  suppliers Supplier[]

  @@map("SupplierType")
}

/// Contract type lookup (FIT / Group / Corporate / …). Global, not tenant-scoped.
model ContractType {
  contractTypeId BigInt    @id @default(autoincrement()) @map("ContractTypeID")
  name           String    @unique @map("ContractTypeName") @db.VarChar(100)
  isActive       Boolean   @default(true) @map("IsActive")
  createdBy      Int       @map("CreatedBy")
  createdDtTm    DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy     Int?      @map("ModifiedBy")
  modifiedDtTm   DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contracts PropertyContract[]

  @@map("ContractType")
}

/// Contract status lookup (Draft / Active / Expired / …). Global, not tenant-scoped.
model ContractStatus {
  contractStatusId BigInt    @id @default(autoincrement()) @map("ContractStatusID")
  name             String    @unique @map("ContractStatusName") @db.VarChar(100)
  isActive         Boolean   @default(true) @map("IsActive")
  createdBy        Int       @map("CreatedBy")
  createdDtTm      DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)
  modifiedBy       Int?      @map("ModifiedBy")
  modifiedDtTm     DateTime? @map("ModifiedDtTm") @db.Timestamptz(6)

  contracts PropertyContract[]

  @@map("ContractStatus")
}

/// Supplier org master — travel supply-side partner (Hotelier, DMC, Transport, Activity Provider, …). Tenant + Company scoped.
model Supplier {
  supplierId             BigInt    @id @default(autoincrement()) @map("SupplierID")
  tenantId               Int       @map("TenantID")
  companyId              Int       @map("CompanyID")
  supplierCode           String    @map("SupplierCode") @db.VarChar(50)
  supplierName           String    @map("SupplierName") @db.VarChar(200)
  supplierLegalName      String    @map("SupplierLegalName") @db.VarChar(250)
  supplierTypeId         BigInt    @map("SupplierTypeID")
  registrationNumber     String?   @map("RegistrationNumber") @db.VarChar(100)
  taxVatNumber           String?   @map("TaxVATNumber") @db.VarChar(100)
  countryId              Int       @map("CountryID")
  stateId                Int?      @map("StateID")
  cityId                 Int       @map("CityID")
  address                String    @map("Address") @db.Text
  postalCode             String?   @map("PostalCode") @db.VarChar(20)
  website                String?   @map("Website") @db.VarChar(250)
  currencyId             Int       @map("CurrencyID")
  /// Static client-side list (see PropertyForm's TIME_ZONES) — no DB FK, matches the existing Property.timeZoneId convention.
  timeZoneId             Int       @map("TimeZoneID")
  requiresExtranetAccess Boolean   @default(false) @map("RequiresExtranetAccess")
  isActive               Boolean   @default(true) @map("IsActive")
  createdBy              Int       @map("CreatedBy")
  createdDtTm            DateTime  @default(now()) @map("CreatedDateTime") @db.Timestamptz(6)
  modifiedBy             Int?      @map("ModifiedBy")
  modifiedDtTm           DateTime? @map("ModifiedDateTime") @db.Timestamptz(6)
  isDeleted              Boolean   @default(false) @map("IsDeleted")

  supplierType  SupplierType       @relation(fields: [supplierTypeId], references: [supplierTypeId], onDelete: Restrict)
  country       Country            @relation(fields: [countryId], references: [countryId], onDelete: Restrict)
  state         State?             @relation(fields: [stateId], references: [stateId], onDelete: SetNull)
  city          City               @relation(fields: [cityId], references: [cityId], onDelete: Restrict)
  currency      Currency           @relation(fields: [currencyId], references: [currencyId], onDelete: Restrict)
  propertyLinks PropertySupplier[]
  supplierUsers SupplierUser[]
  contracts     PropertyContract[]

  @@unique([tenantId, supplierCode], map: "Supplier_Tenant_Code_key")
  @@index([tenantId, companyId], map: "Supplier_TenantID_CompanyID_idx")
  @@index([supplierTypeId], map: "Supplier_SupplierTypeID_idx")
  @@index([countryId], map: "Supplier_CountryID_idx")
  @@index([cityId], map: "Supplier_CityID_idx")
  @@map("Supplier")
}

/// Property ↔ Supplier link — which supplier(s) service a property, with one optional primary supplier.
model PropertySupplier {
  propertySupplierId BigInt    @id @default(autoincrement()) @map("PropertySupplierID")
  propertyId         Int       @map("PropertyID")
  supplierId         BigInt    @map("SupplierID")
  isPrimary          Boolean   @default(false) @map("IsPrimary")
  isActive           Boolean   @default(true) @map("IsActive")
  validFrom          DateTime? @map("ValidFrom") @db.Date
  validTo            DateTime? @map("ValidTo") @db.Date
  createdBy          Int       @map("CreatedBy")
  createdDtTm        DateTime  @default(now()) @map("CreatedDtTm") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)

  supplierAccess SupplierPropertyAccess[]

  @@unique([propertyId, supplierId], map: "PropertySupplier_Property_Supplier_key")
  @@index([supplierId], map: "PropertySupplier_SupplierID_idx")
  @@map("PropertySupplier")
}

/// Supplier's own contact/portal users — a real login User is created alongside every SupplierUser.
model SupplierUser {
  supplierUserId  BigInt    @id @default(autoincrement()) @map("SupplierUserID")
  supplierId      BigInt    @map("SupplierID")
  firstName       String    @map("FirstName") @db.VarChar(100)
  lastName        String    @map("LastName") @db.VarChar(100)
